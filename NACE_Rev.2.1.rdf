	<skos:altLabel xml:lang="sk">Veľkoobchod s poľnohospodárskymi surovinami a živými zvieratami</skos:altLabel>
	<skos:altLabel xml:lang="sl">Trgovina na debelo s kmetijskimi surovinami in živimi živalmi</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/4621">
