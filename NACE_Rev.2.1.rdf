	<skos:altLabel xml:lang="sk">Prenájom a lízing ostatných osobných potrieb a potrieb pre domácnosť</skos:altLabel>
	<skos:altLabel xml:lang="sl">Dajanje drugih izdelkov za široko rabo v najem in zakup</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/773">
	<skos:altLabel xml:lang="en">Rental and leasing of other machinery, equipment and tangible goods</skos:altLabel>
	<skos:altLabel xml:lang="fr">Location et location-bail d’autres machines, équipements et biens</skos:altLabel>
	<skos:altLabel xml:lang="bg">Даване под наем и оперативен лизинг на други машини и оборудване със стопанско предназначение</skos:altLabel>
	<skos:altLabel xml:lang="cs">Pronájem a leasing ostatních strojů, zařízení a hmotných statků</skos:altLabel>
	<skos:altLabel xml:lang="da">Udlejning og leasing af andet materiel, udstyr og andre materielle aktiver</skos:altLabel>
	<skos:altLabel xml:lang="el">Ενοικίαση και εκμίσθωση άλλων μηχανημάτων, ειδών εξοπλισμού και υλικών αγαθών</skos:altLabel>
	<skos:altLabel xml:lang="es">Alquiler de otra maquinaria, equipos y bienes tangibles</skos:altLabel>
	<skos:altLabel xml:lang="et">Muude masinate, seadmete ja materiaalse vara rentimine ja kasutusrent</skos:altLabel>
	<skos:altLabel xml:lang="fi">Koneiden ja laitteiden vuokraus ja leasing</skos:altLabel>
	<skos:altLabel xml:lang="ga">Innealra, trealamh agus earraí inláimhsithe eile a ligean ar cíos agus a léasú</skos:altLabel>
	<skos:altLabel xml:lang="hr">Iznajmljivanje i davanje u zakup (leasing) ostalih strojeva, opreme i materijalnih dobara</skos:altLabel>
	<skos:altLabel xml:lang="hu">Egyéb gép, tárgyi eszköz kölcsönzése</skos:altLabel>
	<skos:altLabel xml:lang="it">Noleggio e leasing operativo di altre macchine, attrezzature e beni materiali</skos:altLabel>
	<skos:altLabel xml:lang="lt">Kitų mašinų, įrangos ir materialiųjų vertybių nuoma ir išperkamoji nuoma</skos:altLabel>
	<skos:altLabel xml:lang="lv">Citu mašīnu, aprīkojuma un materiālu līdzekļu iznomāšana un ekspluatācijas līzings</skos:altLabel>
	<skos:altLabel xml:lang="mt">Kiri u lokazzjoni ta’ makkinarju, ta’ tagħmir u ta’ oġġetti tanġibbli oħra</skos:altLabel>
	<skos:altLabel xml:lang="nl">Verhuur en lease van andere machines en werktuigen en andere materiële goederen</skos:altLabel>
	<skos:altLabel xml:lang="pt">Aluguer de outras máquinas, equipamentos e bens tangíveis</skos:altLabel>
	<skos:altLabel xml:lang="ro">Închiriere și leasing de alte mașini, echipamente și bunuri corporale</skos:altLabel>
	<skos:altLabel xml:lang="sv">Uthyrning och leasing av annan utrustning och andra maskiner och materiella tillgångar</skos:altLabel>
	<skos:altLabel xml:lang="de">Vermietung von Maschinen, Geräten und sonstigen beweglichen Sachen</skos:altLabel>
	<skos:altLabel xml:lang="pl">Wynajem i dzierżawa pozostałych maszyn, urządzeń oraz dóbr materialnych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Prenájom a lízing ostatných strojov, zariadení a iného hmotného majetku</skos:altLabel>
	<skos:altLabel xml:lang="sl">Dajanje strojev, naprav in drugih opredmetenih sredstev v najem in zakup</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/7731">
	<skos:altLabel xml:lang="en">Rental and leasing of agricultural machinery and equipment</skos:altLabel>
	<skos:altLabel xml:lang="fr">Location et location-bail de matériel agricole</skos:altLabel>
	<skos:altLabel xml:lang="bg">Даване под наем и оперативен лизинг на машини и оборудване за селското и горско стопанство, без оператор</skos:altLabel>
	<skos:altLabel xml:lang="cs">Pronájem a leasing zemědělských strojů a zařízení</skos:altLabel>
	<skos:altLabel xml:lang="da">Udlejning og leasing af landbrugsmaskiner og -udstyr</skos:altLabel>
	<skos:altLabel xml:lang="el">Ενοικίαση και εκμίσθωση γεωργικών μηχανημάτων και εξοπλισμού</skos:altLabel>
	<skos:altLabel xml:lang="es">Alquiler de maquinaria y equipo de uso agrícola</skos:altLabel>
	<skos:altLabel xml:lang="et">Põllumajandusmasinate ja -seadmete rentimine ja kasutusrent</skos:altLabel>
	<skos:altLabel xml:lang="fi">Maatalouskoneiden ja -laitteiden vuokraus ja leasing</skos:altLabel>
	<skos:altLabel xml:lang="ga">Innealra agus trealamh talmhaíochta a ligean ar cíos agus a léasú</skos:altLabel>
	<skos:altLabel xml:lang="hr">Iznajmljivanje i davanje u zakup (leasing) poljoprivrednih strojeva i opreme</skos:altLabel>
	<skos:altLabel xml:lang="hu">Mezőgazdasági gép kölcsönzése</skos:altLabel>
	<skos:altLabel xml:lang="it">Noleggio e leasing operativo di macchine e attrezzature agricole</skos:altLabel>
	<skos:altLabel xml:lang="lt">Žemės ūkio mašinų ir įrangos nuoma ir išperkamoji nuoma</skos:altLabel>
	<skos:altLabel xml:lang="lv">Lauksaimniecības mašīnu un aprīkojuma iznomāšana un ekspluatācijas līzings</skos:altLabel>
	<skos:altLabel xml:lang="mt">Kiri u lokazzjoni tal-makkinarju u t-tagħmir agrikolu</skos:altLabel>
	<skos:altLabel xml:lang="nl">Verhuur en lease van landbouwmachines en -werktuigen</skos:altLabel>
	<skos:altLabel xml:lang="pt">Aluguer de máquinas e equipamentos agrícolas</skos:altLabel>
	<skos:altLabel xml:lang="ro">Închiriere și leasing de mașini și echipamente agricole</skos:altLabel>
	<skos:altLabel xml:lang="sv">Uthyrning och leasing av jordbruksmaskiner och jordbruksredskap</skos:altLabel>
	<skos:altLabel xml:lang="de">Vermietung von landwirtschaftlichen Maschinen und Geräten</skos:altLabel>
	<skos:altLabel xml:lang="pl">Wynajem i dzierżawa maszyn i urządzeń rolniczych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Prenájom a lízing poľnohospodárskych strojov a zariadení</skos:altLabel>
	<skos:altLabel xml:lang="sl">Dajanje kmetijskih strojev in opreme v najem in zakup</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/7732">
	<skos:altLabel xml:lang="en">Rental and leasing of construction and civil engineering machinery and equipment</skos:altLabel>
