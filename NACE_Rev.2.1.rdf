<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/6499">
	<skos:prefLabel xml:lang="en">64.99 Other financial service activities, except insurance and pension funding n.e.c.</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">64.99 Autres activités des services financiers, hors assurance et fonds de pension, n.c.a.</skos:prefLabel>
	<skos:prefLabel xml:lang="bg">64.99 Предоставяне на други финансови услуги, без застраховане и допълнително пенсионно осигуряване, некласифицирани другаде</skos:prefLabel>
	<skos:prefLabel xml:lang="cs">64.99 Ostatní finanční činnosti, kromě pojišťování a penzijního financování j. n.</skos:prefLabel>
	<skos:prefLabel xml:lang="da">64.99 Andre finansielle tjenesteydelser, undtagen forsikring og pensionsforsikring i.a.n.</skos:prefLabel>
	<skos:prefLabel xml:lang="el">64.99 Άλλες δραστηριότητες χρηματοπιστωτικών υπηρεσιών, με εξαίρεση τις ασφάλειες και τα συνταξιοδοτικά ταμεία π.δ.κ.α.</skos:prefLabel>
	<skos:prefLabel xml:lang="es">64.99 Otros servicios financieros, excepto seguros y fondos de pensiones n.c.o.p.</skos:prefLabel>
	<skos:prefLabel xml:lang="et">64.99 Muud mujal liigitamata finantsteenused, v.a kindlustus ja pensionifondid</skos:prefLabel>
	<skos:prefLabel xml:lang="fi">64.99 Muualla luokittelematon muu rahoituspalvelutoiminta pois lukien vakuutus- ja eläkevakuutustoiminta</skos:prefLabel>
	<skos:prefLabel xml:lang="ga">64.99 Gníomhaíochtaí seirbhíse airgeadais eile, seachas árachas agus cistiú pinsin nach n-aicmítear in áit ar bith eile</skos:prefLabel>
	<skos:prefLabel xml:lang="hr">64.99 Ostale financijske uslužne djelatnosti osim osiguranja i mirovinskih fondova, d.n.</skos:prefLabel>
	<skos:prefLabel xml:lang="hu">64.99 M.n.s. egyéb pénzügyi közvetítés</skos:prefLabel>
	<skos:prefLabel xml:lang="it">64.99 Altre attività di servizi finanziari, ad esclusione di assicurazioni e fondi pensione n.c.a.</skos:prefLabel>
	<skos:prefLabel xml:lang="lt">64.99 Kita, niekur kitur nepriskirta, finansinių paslaugų veikla, išskyrus draudimą ir pensijų lėšų kaupimą</skos:prefLabel>
	<skos:prefLabel xml:lang="lv">64.99 Citur neklasificēti finanšu pakalpojumi, izņemot apdrošināšanu un pensiju finansēšanu</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">64.99 Attivitajiet oħra ta’ servizz finanzjarju, għajr l-assigurazzjoni u l-finanzjament tal-pensjoni m.k.b.</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">64.99 Overige financiële dienstverlening, exclusief verzekeringen en pensioenfondsen, n.e.g.</skos:prefLabel>
	<skos:prefLabel xml:lang="pt">64.99 Outras atividades de serviços financeiros, exceto seguros e fundos de pensões, n.e.</skos:prefLabel>
	<skos:prefLabel xml:lang="ro">64.99 Alte activități financiare, cu excepția asigurărilor și a fondurilor de pensii n.c.a.</skos:prefLabel>
	<skos:prefLabel xml:lang="sl">64.99 Druge dejavnosti finančnih storitev, razen zavarovalništva in dejavnosti pokojninskih skladov, d. n.</skos:prefLabel>
	<skos:prefLabel xml:lang="sv">64.99 Diverse övrig finansiell verksamhet utom försäkrings- och pensionsfondsverksamhet</skos:prefLabel>
	<skos:prefLabel xml:lang="de">64.99 Sonstige Finanzdienstleistungen a. n. g.</skos:prefLabel>
	<skos:prefLabel xml:lang="pl">64.99 Pozostała finansowa działalność usługowa, z wyłączeniem ubezpieczeń i funduszy emerytalnych, gdzie indziej niesklasyfikowana</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">64.99 Ostatné finančné služby okrem poistenia a dôchodkového zabezpečenia i. n.</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/65">
	<skos:prefLabel xml:lang="en">65 Insurance, reinsurance and pension funding, except compulsory social security</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">65 Assurance, réassurance et fonds de pension, à l’exclusion de la sécurité sociale obligatoire</skos:prefLabel>
	<skos:prefLabel xml:lang="bg">65 Застраховане, презастраховане и допълнително пенсионно осигуряване</skos:prefLabel>
	<skos:prefLabel xml:lang="cs">65 Pojišťovací a zajišťovací činnosti, penzijní financování, kromě povinného sociálního zabezpečení</skos:prefLabel>
	<skos:prefLabel xml:lang="da">65 Forsikring, genforsikring og pensionsforsikring, undtagen lovpligtig socialforsikring</skos:prefLabel>
	<skos:prefLabel xml:lang="el">65 Ασφαλιστικά, αντασφαλιστικά και συνταξιοδοτικά ταμεία, εκτός από την υποχρεωτική κοινωνική ασφάλιση</skos:prefLabel>
	<skos:prefLabel xml:lang="es">65 Seguros, reaseguros y planes de pensiones, excepto seguridad social obligatoria</skos:prefLabel>
	<skos:prefLabel xml:lang="et">65 Kindlustus, edasikindlustus ja pensionifondid, v.a kohustuslik sotsiaalkindlustus</skos:prefLabel>
	<skos:prefLabel xml:lang="fi">65 Vakuutus-, jälleenvakuutus- ja eläkevakuutustoiminta pois lukien pakollinen sosiaalivakuutus</skos:prefLabel>
	<skos:prefLabel xml:lang="ga">65 Árachas, athárachas agus cistiú pinsin, seachas leas sóisialta éigeantach</skos:prefLabel>
	<skos:prefLabel xml:lang="hr">65 Osiguranje, reosiguranje i mirovinski fondovi, osim obveznog socijalnog osiguranja</skos:prefLabel>
	<skos:prefLabel xml:lang="hu">65 Biztosítás, viszontbiztosítás, nyugdíjalapok (kivéve: kötelező társadalombiztosítás)</skos:prefLabel>
	<skos:prefLabel xml:lang="it">65 Assicurazioni, riassicurazioni e fondi pensione, escluse le assicurazioni sociali obbligatorie</skos:prefLabel>
	<skos:prefLabel xml:lang="lt">65 Draudimo, perdraudimo ir pensijų lėšų kaupimo, išskyrus privalomąjį socialinį draudimą, veikla</skos:prefLabel>
	<skos:prefLabel xml:lang="lv">65 Apdrošināšana, pārapdrošināšana un pensiju finansēšana, izņemot obligāto sociālo apdrošināšanu</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">65 Assigurazzjoni, riassigurazzjoni u finanzjament tal-pensjoni, għajr is-sigurtà soċjali obbligatorja</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">65 Activiteiten op het gebied van verzekeringen en pensioenfondsen, exclusief verplichte sociale verzekeringen</skos:prefLabel>
	<skos:prefLabel xml:lang="pt">65 Seguros, resseguros e fundos de pensões, exceto segurança social obrigatória</skos:prefLabel>
	<skos:prefLabel xml:lang="ro">65 Asigurări, reasigurări și fonduri de pensii, cu excepția asigurărilor sociale obligatorii</skos:prefLabel>
	<skos:prefLabel xml:lang="sl">65 Dejavnost zavarovanja, pozavarovanja in pokojninskih skladov, razen obvezne socialne varnosti</skos:prefLabel>
	<skos:prefLabel xml:lang="sv">65 Försäkrings-, återförsäkrings- och pensionsfondsverksamhet utom obligatorisk socialförsäkring</skos:prefLabel>
	<skos:prefLabel xml:lang="de">65 Versicherungen, Rückversicherungen und Pensionskassen, ohne Sozialversicherung</skos:prefLabel>
	<skos:prefLabel xml:lang="pl">65 Działalność w zakresie ubezpieczeń, reasekuracji oraz funduszy emerytalnych, z wyłączeniem obowiązkowego ubezpieczenia społecznego</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">65 Poistenie, zaistenie a dôchodkové zabezpečenie okrem povinného sociálneho zabezpečenia</skos:prefLabel>
</rdf:Description>

