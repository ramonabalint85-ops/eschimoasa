	<skos:altLabel xml:lang="hu">Gabona, feldolgozatlan dohány, vetőmag, takarmány nagykereskedelme</skos:altLabel>
	<skos:altLabel xml:lang="it">Commercio all’ingrosso di cereali, tabacco grezzo, sementi e alimenti per il bestiame</skos:altLabel>
