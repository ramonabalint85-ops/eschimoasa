<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/023">
	<skos:altLabel xml:lang="en">Gathering of wild growing non-wood products</skos:altLabel>
	<skos:altLabel xml:lang="fr">Récolte de produits forestiers non ligneux poussant à l’état sauvage</skos:altLabel>
	<skos:altLabel xml:lang="bg">Събиране на диворастящи и недървесни продукти</skos:altLabel>
	<skos:altLabel xml:lang="cs">Sběr a získávání volně rostoucích plodů a materiálů, kromě dřeva</skos:altLabel>
	<skos:altLabel xml:lang="da">Indsamling af vildtvoksende forstmateriale, undtagen træer</skos:altLabel>
	<skos:altLabel xml:lang="el">Συλλογή προϊόντων αυτοφυών φυτών μη ξυλώδους μορφής</skos:altLabel>
	<skos:altLabel xml:lang="es">Recolección de productos silvestres, excepto madera</skos:altLabel>
	<skos:altLabel xml:lang="et">Loodussaaduste, v.a puidu varumine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Luonnonvaraisina kasvavien tuotteiden keruu pois lukien puu</skos:altLabel>
	<skos:altLabel xml:lang="ga">Bailiú táirgí neamh-adhmaid a fhásann go fiáin</skos:altLabel>
	<skos:altLabel xml:lang="hr">Skupljanje samoniklih plodova i proizvoda, osim drva</skos:altLabel>
	<skos:altLabel xml:lang="hu">Vadon termő erdei termény gyűjtése</skos:altLabel>
	<skos:altLabel xml:lang="it">Raccolta di prodotti selvatici non legnosi</skos:altLabel>
	<skos:altLabel xml:lang="lt">Laukinių nemedieninių produktų rinkimas</skos:altLabel>
	<skos:altLabel xml:lang="lv">Meža nekoksnes produktu vākšana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Ġbir ta’ prodotti mhux tal-injam li jikbru fis-salvaġġ</skos:altLabel>
	<skos:altLabel xml:lang="nl">Verzamelen van in het wild groeiende producten met uitzondering van hout</skos:altLabel>
	<skos:altLabel xml:lang="pt">Extração de cortiça, resina e de outros produtos florestais, exceto madeira</skos:altLabel>
	<skos:altLabel xml:lang="ro">Colectarea produselor nelemnoase din flora spontană</skos:altLabel>
	<skos:altLabel xml:lang="sl">Nabiranje gozdnih dobrin, razen lesa</skos:altLabel>
	<skos:altLabel xml:lang="sk">Zber divorastúceho materiálu (okrem dreva)</skos:altLabel>
	<skos:altLabel xml:lang="sv">Insamling av annat vilt växande skogsmaterial än trä</skos:altLabel>
	<skos:altLabel xml:lang="de">Sammeln von wildwachsenden Produkten, ohne Holz</skos:altLabel>
	<skos:altLabel xml:lang="pl">Pozyskiwanie dziko rosnących produktów leśnych, z wyłączeniem drewna</skos:altLabel>
</rdf:Description>

