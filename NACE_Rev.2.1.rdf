<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/162">
	<skos:prefLabel xml:lang="en">16.2 Manufacture of products of wood, cork, straw and plaiting materials</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">16.2 Fabrication d’articles en bois, liège, vannerie et sparterie</skos:prefLabel>
