	<skos:prefLabel xml:lang="lv">95.1 Datoru un sakaru iekārtu remonts un apkope</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">95.1 Tiswija u manutenzjoni tal-kompjuters u t-tagħmir tal-komunikazzjoni</skos:prefLabel>
