	<skos:prefLabel xml:lang="ga">82.4 Gníomhaíochtaí seirbhíse idirghabhála le haghaidh gníomhaíochtaí seirbhíse tacaíochta gnó nach n-aicmítear in áit ar bith eile</skos:prefLabel>
	<skos:prefLabel xml:lang="hr">82.4 Uslužne djelatnosti posredovanja za poslovne pomoćne uslužne djelatnosti, d. n.</skos:prefLabel>
