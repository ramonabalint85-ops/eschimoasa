<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/3318">
	<skos:altLabel xml:lang="en">Repair and maintenance of military fighting vehicles, ships, boats, air and spacecraft</skos:altLabel>
	<skos:altLabel xml:lang="fr">Réparation et entretien de véhicules de combat, de navires, de bateaux, d’aéronefs et d’engins spatiaux militaires</skos:altLabel>
