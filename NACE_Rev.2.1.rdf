	<skos:altLabel xml:lang="de">Großhandel mit Getreide, Rohtabak, Saatgut und Futtermitteln</skos:altLabel>
	<skos:altLabel xml:lang="pl">Sprzedaż hurtowa zboża, nieprzetworzonego tytoniu, nasion i pasz dla zwierząt</skos:altLabel>
