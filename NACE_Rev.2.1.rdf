	<skos:altLabel xml:lang="ga">Mórdhíol ar bhonn táille nó conartha</skos:altLabel>
	<skos:altLabel xml:lang="hr">Trgovina na veliko uz naplatu ili na osnovi ugovora</skos:altLabel>
