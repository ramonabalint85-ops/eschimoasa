	<skos:prefLabel xml:lang="ga">E SOLÁTHAR UISCE SÉARACHAS, BAINISTIÚ DRAMHAÍOLA AGUS GNÍOMHAÍOCHTAÍ FEABHSÚCHÁIN</skos:prefLabel>
	<skos:prefLabel xml:lang="hr">E OPSKRBA VODOM; UKLANJANJE OTPADNIH VODA, GOSPODARENJE OTPADOM TE DJELATNOSTI SANACIJE OKOLIŠA</skos:prefLabel>
	<skos:prefLabel xml:lang="hu">E VÍZELLÁTÁS; SZENNYVÍZ GYŰJTÉSE, KEZELÉSE, HULLADÉKGAZDÁLKODÁS, SZENNYEZÉSMENTESÍTÉS</skos:prefLabel>
	<skos:prefLabel xml:lang="it">E FORNITURA DI ACQUA; GESTIONE DI RETI FOGNARIE, ATTIVITÀ DI TRATTAMENTO DEI RIFIUTI E RISANAMENTO</skos:prefLabel>
	<skos:prefLabel xml:lang="lt">E VANDEN TIEKIMAS; NUOTEKŲ VALYMAS, ATLIEKŲ TVARKYMAS IR REGENERAVIMAS</skos:prefLabel>
	<skos:prefLabel xml:lang="lv">E ŪDENSAPGĀDE; KANALIZĀCIJAS, ATKRITUMU APSAIMNIEKOŠANAS UN REMEDIĀCIJAS DARBĪBAS</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">E PROVVISTA TAL-ILMA; SISTEMI TAD-DRENAĠĠ, IMMANIĠĠJAR TAL-ISKART U ATTIVITAJIET RIMEDJATORJI</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">E DISTRIBUTIE VAN WATER; AFVAL- EN AFVALWATERBEHEER EN SANERING</skos:prefLabel>
	<skos:prefLabel xml:lang="pt">E CAPTAÇÃO, TRATAMENTO E DISTRIBUIÇÃO DE ÁGUA; SANEAMENTO, GESTÃO DE RESÍDUOS E DESPOLUIÇÃO</skos:prefLabel>
	<skos:prefLabel xml:lang="ro">E DISTRIBUȚIA APEI; SALUBRITATE, GESTIONARE A DEȘEURILOR ȘI ACTIVITĂȚI DE DECONTAMINARE</skos:prefLabel>
	<skos:prefLabel xml:lang="sv">E VATTENFÖRSÖRJNING; AVLOPPSRENING, AVFALLSHANTERING OCH SANERING</skos:prefLabel>
	<skos:prefLabel xml:lang="de">E WASSERVERSORGUNG; ABWASSER- UND ABFALLENTSORGUNG UND BESEITIGUNG VON UMWELTVERSCHMUTZUNGEN</skos:prefLabel>
	<skos:prefLabel xml:lang="pl">E DOSTAWA WODY; GOSPODAROWANIE ŚCIEKAMI I ODPADAMI ORAZ DZIAŁALNOŚĆ ZWIĄZANA Z REKULTYWACJĄ</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">E DODÁVKA VODY; ČISTENIE A ODVOD ODPADOVÝCH VÔD, ODPADY A SLUŽBY ODSTRAŇOVANIA ODPADOV</skos:prefLabel>
	<skos:prefLabel xml:lang="sl">E OSKRBA Z VODO; RAVNANJE Z ODPLAKAMI IN ODPADKI; SANIRANJE OKOLJA</skos:prefLabel>
</rdf:Description>

