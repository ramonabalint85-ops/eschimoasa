	<skos:altLabel xml:lang="mt">Manifattura oħra m.k.b.</skos:altLabel>
	<skos:altLabel xml:lang="nl">Overige industrie, n.e.g.</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja pozostałych wyrobów, gdzie indziej niesklasyfikowana</skos:altLabel>
