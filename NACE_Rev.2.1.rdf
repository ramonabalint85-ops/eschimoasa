	<skos:prefLabel xml:lang="lt">85.3 Pagrindinis ir vidurinis ugdymas, aukštojo mokslo laipsnio nesuteikiantis mokymas turint vidurinį išsilavinimą</skos:prefLabel>
	<skos:prefLabel xml:lang="lv">85.3 Vidējā izglītība un pēcvidējā izglītība, kas nav augstākā izglītība</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">85.3 Edukazzjoni sekondarja u postsekondarja nonterzjarja</skos:prefLabel>
