	<skos:altLabel xml:lang="mt">Manifattura tal-preparati tal-ħasil, tat-tindif u tal-illostrar</skos:altLabel>
	<skos:altLabel xml:lang="nl">Vervaardiging van was-, poets- en reinigingsmiddelen</skos:altLabel>
