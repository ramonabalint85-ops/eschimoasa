<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/552">
	<skos:altLabel xml:lang="en">Holiday and other short-stay accommodation</skos:altLabel>
	<skos:altLabel xml:lang="fr">Hébergement touristique et autre hébergement de courte durée</skos:altLabel>
	<skos:altLabel xml:lang="bg">Туристическо и друго краткосрочно настаняване</skos:altLabel>
	<skos:altLabel xml:lang="cs">Rekreační a ostatní krátkodobé ubytování</skos:altLabel>
	<skos:altLabel xml:lang="da">Drift af ferieboliger og andre overnatningsfaciliteter til kortvarige ophold</skos:altLabel>
