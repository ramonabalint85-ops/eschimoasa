	<skos:altLabel xml:lang="sl">Popravila in vzdrževanje motornih vozil</skos:altLabel>
	<skos:altLabel xml:lang="sv">Reparation och underhåll av motorfordon</skos:altLabel>
	<skos:altLabel xml:lang="de">Reparatur und Instandhaltung von Kraftwagen</skos:altLabel>
	<skos:altLabel xml:lang="pl">Naprawa i konserwacja pojazdów silnikowych z wyłączeniem motocykli</skos:altLabel>
