	<skos:altLabel xml:lang="sv">Utvinning av sand, grus och berg samt utvinning av lera och kaolin</skos:altLabel>
	<skos:altLabel xml:lang="de">Gewinnung von Kies und Sand, Ton und Kaolin</skos:altLabel>
	<skos:altLabel xml:lang="pl">Wydobywanie żwiru, piasku, gliny i kaolinu</skos:altLabel>
	<skos:altLabel xml:lang="sk">Prevádzka štrkovísk a pieskovísk, ťažba ílu a kaolínu</skos:altLabel>
