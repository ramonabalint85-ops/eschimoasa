<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/303">
	<skos:altLabel xml:lang="en">Manufacture of air and spacecraft and related machinery</skos:altLabel>
	<skos:altLabel xml:lang="fr">Construction aéronautique et spatiale</skos:altLabel>
	<skos:altLabel xml:lang="bg">Производство на въздухоплавателни и космически средства и техните двигатели</skos:altLabel>
	<skos:altLabel xml:lang="cs">Výroba letadel, kosmických lodí a souvisejících zařízení</skos:altLabel>
	<skos:altLabel xml:lang="da">Fremstilling af luft- og rumfartøjer o.l.</skos:altLabel>
	<skos:altLabel xml:lang="el">Κατασκευή αεροσκαφών και διαστημοπλοίων και συναφών μηχανημάτων</skos:altLabel>
