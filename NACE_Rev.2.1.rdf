	<skos:altLabel xml:lang="ga">Gníomhaíochtaí cúnta do sheirbhísí airgeadais agus árachais</skos:altLabel>
	<skos:altLabel xml:lang="hr">Pomoćne djelatnosti za financijske usluge i djelatnosti osiguranja</skos:altLabel>
	<skos:altLabel xml:lang="hu">Pénzügyi, biztosítási kiegészítő tevékenységek</skos:altLabel>
