<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/0811">
	<skos:altLabel xml:lang="en">Quarrying of ornamental stone, limestone, gypsum, slate and other stone</skos:altLabel>
	<skos:altLabel xml:lang="fr">Extraction de pierres ornementales, de calcaire industriel, de gypse, d’ardoise et d’autres pierres</skos:altLabel>
