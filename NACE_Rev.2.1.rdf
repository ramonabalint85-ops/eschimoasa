	<skos:altLabel xml:lang="ro">Spălarea și curățarea articolelor textile și a produselor din blană</skos:altLabel>
	<skos:altLabel xml:lang="sl">Dejavnost pralnic in kemičnih čistilnic</skos:altLabel>
	<skos:altLabel xml:lang="sv">Tvätteriverksamhet</skos:altLabel>
