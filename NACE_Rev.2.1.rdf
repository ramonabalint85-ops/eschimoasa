<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/683">
	<skos:altLabel xml:lang="en">Real estate activities on a fee or contract basis</skos:altLabel>
	<skos:altLabel xml:lang="fr">Activités immobilières pour compte de tiers</skos:altLabel>
	<skos:altLabel xml:lang="bg">Операции с недвижими имоти срещу възнаграждение или по договор</skos:altLabel>
	<skos:altLabel xml:lang="cs">Činnosti v oblasti nemovitostí na základě smlouvy nebo dohody</skos:altLabel>
	<skos:altLabel xml:lang="da">Aktiviteter i forbindelse med fast ejendom på honorar- eller kontraktbasis</skos:altLabel>
	<skos:altLabel xml:lang="el">Διαχείριση ακίνητης περιουσίας έναντι αμοιβής ή βάσει σύμβασης</skos:altLabel>
	<skos:altLabel xml:lang="es">Actividades inmobiliarias por cuenta de terceros</skos:altLabel>
	<skos:altLabel xml:lang="et">Kinnisvaraalane tegevus tasu eest või lepingu alusel</skos:altLabel>
	<skos:altLabel xml:lang="fi">Kiinteistöalan toiminta palkkio- tai sopimusperusteisesti</skos:altLabel>
	<skos:altLabel xml:lang="ga">Gníomhaíochtaí eastáit réadaigh ar bhonn táille nó conartha</skos:altLabel>
	<skos:altLabel xml:lang="hr">Poslovanje nekretninama uz naplatu ili na osnovi ugovora</skos:altLabel>
	<skos:altLabel xml:lang="hu">Ingatlanügynöki, -kezelési szolgáltatás díjazásos vagy szerződéses alapon</skos:altLabel>
	<skos:altLabel xml:lang="it">Attività immobiliari per conto terzi</skos:altLabel>
	<skos:altLabel xml:lang="lt">Nekilnojamojo turto operacijos už atlygį arba pagal sutartį</skos:altLabel>
	<skos:altLabel xml:lang="lv">Operācijas ar nekustamo īpašumu uz līguma pamata vai par atlīdzību</skos:altLabel>
	<skos:altLabel xml:lang="mt">Attivitajiet tal-proprjetà immobbli abbażi ta’ tariffa jew kuntratt</skos:altLabel>
	<skos:altLabel xml:lang="nl">Bemiddeling in en beheer van onroerend goed voor een vast bedrag of op contractbasis</skos:altLabel>
	<skos:altLabel xml:lang="pt">Atividades imobiliárias por conta de outrem</skos:altLabel>
	<skos:altLabel xml:lang="ro">Activități imobiliare pe bază de comision sau contract</skos:altLabel>
	<skos:altLabel xml:lang="sv">Fastighetsförmedling och fastighetsförvaltning på uppdrag</skos:altLabel>
	<skos:altLabel xml:lang="de">Vermittlung und Verwaltung von Grundstücken, Gebäuden und Wohnungen für Dritte</skos:altLabel>
	<skos:altLabel xml:lang="pl">Działalność związana z obsługą rynku nieruchomości wykonywana na zlecenie</skos:altLabel>
	<skos:altLabel xml:lang="sk">Činnosti v oblasti nehnuteľností na základe poplatkov alebo zmlúv</skos:altLabel>
	<skos:altLabel xml:lang="sl">Poslovanje z nepremičninami za plačilo ali po pogodbi</skos:altLabel>
</rdf:Description>

