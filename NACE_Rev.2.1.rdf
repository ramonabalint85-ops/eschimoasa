	<skos:prefLabel xml:lang="hr">86.97 Uslužne djelatnosti posredovanja za medicinske, stomatološke i druge zdravstvene usluge</skos:prefLabel>
	<skos:prefLabel xml:lang="hu">86.97 Orvosi, fogorvosi és egyéb humánegészségügyi szolgáltatás közvetítése</skos:prefLabel>
