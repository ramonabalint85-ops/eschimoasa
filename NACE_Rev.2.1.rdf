	<skos:altLabel xml:lang="sl">Proizvodnja pesticidov, razkužil in drugih agrokemičnih izdelkov</skos:altLabel>
	<skos:altLabel xml:lang="sv">Tillverkning av bekämpningsmedel, desinfektionsmedel och andra lantbrukskemiska produkter</skos:altLabel>
	<skos:altLabel xml:lang="de">Herstellung von Schädlingsbekämpfungs-, Pflanzenschutz- und Desinfektionsmitteln</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja pestycydów, środków dezynfekujących i pozostałych środków agrochemicznych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výroba pesticídov, dezinfekčných prostriedkov a iných agrochemických produktov</skos:altLabel>
</rdf:Description>

