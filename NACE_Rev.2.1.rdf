	<skos:altLabel xml:lang="de">Tätigkeiten von Strom- und Erdgasmaklerinnen und -maklern</skos:altLabel>
	<skos:altLabel xml:lang="pl">Działalność brokerów i agentów w zakresie energii elektrycznej i gazu ziemnego</skos:altLabel>
	<skos:altLabel xml:lang="sk">Činnosti maklérov a sprostredkovateľov v oblasti elektriny a zemného plynu</skos:altLabel>
</rdf:Description>

