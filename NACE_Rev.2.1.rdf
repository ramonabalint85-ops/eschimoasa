	<skos:altLabel xml:lang="lv">Citu personīgas lietošanas un mājsaimniecības preču iznomāšana un ekspluatācijas līzings</skos:altLabel>
	<skos:altLabel xml:lang="mt">Kiri u lokazzjoni ta’ oġġetti personali u domestiċi oħra</skos:altLabel>
