	<skos:altLabel xml:lang="bg">Пране и химическо чистене</skos:altLabel>
	<skos:altLabel xml:lang="cs">Praní a čištění textilních a kožešinových výrobků</skos:altLabel>
	<skos:altLabel xml:lang="da">Vask og rensning af tekstiler og pelsværk</skos:altLabel>
