<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/9623">
	<skos:altLabel xml:lang="en">Day spa, sauna and steam bath activities</skos:altLabel>
	<skos:altLabel xml:lang="fr">Activités de spa, de sauna et de bain de vapeur</skos:altLabel>
	<skos:altLabel xml:lang="bg">Дейности на дневни спа центрове, сауни и парни бани</skos:altLabel>
	<skos:altLabel xml:lang="cs">Činnosti denních lázní, saun a parních lázní</skos:altLabel>
