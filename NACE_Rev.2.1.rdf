<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/4616">
	<skos:prefLabel xml:lang="en">46.16 Activities of agents involved in the wholesale of textiles, clothing, fur, footwear and leather goods</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">46.16 Activités d’intermédiaire du commerce de gros en textiles, habillement, fourrures, chaussures et articles en cuir</skos:prefLabel>
