	<skos:altLabel xml:lang="bg">Производство на други машини с общо предназначение</skos:altLabel>
	<skos:altLabel xml:lang="cs">Výroba ostatních strojů a zařízení pro všeobecné účely</skos:altLabel>
	<skos:altLabel xml:lang="da">Fremstilling af andre maskiner til generelle formål</skos:altLabel>
