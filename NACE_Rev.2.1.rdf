	<skos:prefLabel xml:lang="lv">16.2 Koka, korķa, salmu un pīto izstrādājumu ražošana</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">16.2 Manifattura tal-prodotti tal-injam, is-sufra, it-tiben u l-materjali tad-dfir</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">16.2 Vervaardiging van artikelen van hout, kurk, riet of vlechtwerk</skos:prefLabel>
