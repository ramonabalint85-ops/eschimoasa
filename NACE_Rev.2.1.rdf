	<skos:altLabel xml:lang="ro">Închiriere și leasing de mașini și echipamente de construcții civile</skos:altLabel>
	<skos:altLabel xml:lang="sv">Uthyrning och leasing av bygg- och anläggningsmaskiner</skos:altLabel>
	<skos:altLabel xml:lang="de">Vermietung von Baumaschinen und -geräten</skos:altLabel>
	<skos:altLabel xml:lang="pl">Wynajem i dzierżawa maszyn i urządzeń budowlanych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Prenájom a lízing stavbárskych strojov a zariadení</skos:altLabel>
	<skos:altLabel xml:lang="sl">Dajanje gradbenih strojev in opreme v najem in zakup</skos:altLabel>
