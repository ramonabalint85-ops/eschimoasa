	<skos:altLabel xml:lang="pl">Pranie i czyszczenie wyrobów tekstylnych i futrzarskich</skos:altLabel>
	<skos:altLabel xml:lang="sk">Pranie a chemické čistenie textilných a kožušinových výrobkov</skos:altLabel>
