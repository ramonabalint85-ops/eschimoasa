	<skos:altLabel xml:lang="de">Reparatur und Instandhaltung von Möbeln und Einrichtungsgegenständen</skos:altLabel>
	<skos:altLabel xml:lang="pl">Naprawa i konserwacja mebli i wyposażenia domowego</skos:altLabel>
	<skos:altLabel xml:lang="sk">Oprava a údržba nábytku a domácich zariadení</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/9525">
	<skos:altLabel xml:lang="en">Repair and maintenance of watches, clocks and jewellery</skos:altLabel>
	<skos:altLabel xml:lang="fr">Réparation et entretien d’articles d’horlogerie et de bijouterie</skos:altLabel>
	<skos:altLabel xml:lang="bg">Ремонт и поддържане на часовници и бижута</skos:altLabel>
	<skos:altLabel xml:lang="cs">Opravy a údržba hodin, hodinek a klenotů</skos:altLabel>
	<skos:altLabel xml:lang="da">Reparation og vedligeholdelse af ure og smykker</skos:altLabel>
	<skos:altLabel xml:lang="el">Επισκευή και συντήρηση ρολογιών και κοσμημάτων</skos:altLabel>
	<skos:altLabel xml:lang="es">Reparación y mantenimiento de relojes y joyería</skos:altLabel>
	<skos:altLabel xml:lang="et">Kellade ja ehete parandus ja hooldus</skos:altLabel>
	<skos:altLabel xml:lang="fi">Kellojen ja korujen korjaus ja huolto</skos:altLabel>
	<skos:altLabel xml:lang="ga">Deisiú agus cothabháil uaireadóirí, clog agus seodra</skos:altLabel>
	<skos:altLabel xml:lang="hr">Popravak i održavanje satova i nakita</skos:altLabel>
	<skos:altLabel xml:lang="hu">Óra-, ékszerjavítás, -karbantartás</skos:altLabel>
	<skos:altLabel xml:lang="it">Riparazione e manutenzione di orologi e gioielli</skos:altLabel>
	<skos:altLabel xml:lang="lt">Įvairių tipų laikrodžių ir juvelyrinių dirbinių taisymas ir priežiūra</skos:altLabel>
	<skos:altLabel xml:lang="lv">Pulksteņu un juvelierizstrādājumu remonts un apkope</skos:altLabel>
	<skos:altLabel xml:lang="mt">Tiswija u manutenzjoni tal-arloġġi tal-id, tal-arloġġi u tal-ġojjellerija</skos:altLabel>
	<skos:altLabel xml:lang="nl">Reparatie en onderhoud van uurwerken en sieraden</skos:altLabel>
	<skos:altLabel xml:lang="pt">Reparação e manutenção de relógios e de artigos de joalharia</skos:altLabel>
	<skos:altLabel xml:lang="ro">Repararea și întreținerea ceasurilor, orologiilor și bijuteriilor</skos:altLabel>
	<skos:altLabel xml:lang="sl">Popravila in vzdrževanje ur in nakita</skos:altLabel>
	<skos:altLabel xml:lang="sv">Reparation och underhåll av ur och guldsmedsvaror</skos:altLabel>
	<skos:altLabel xml:lang="de">Reparatur und Instandhaltung von Uhren und Schmuck</skos:altLabel>
	<skos:altLabel xml:lang="pl">Naprawa i konserwacja zegarów, zegarków oraz biżuterii</skos:altLabel>
	<skos:altLabel xml:lang="sk">Oprava a údržba hodín, hodiniek a šperkov</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/9529">
	<skos:altLabel xml:lang="en">Repair and maintenance of personal and household goods n.e.c.</skos:altLabel>
	<skos:altLabel xml:lang="fr">Réparation et entretien d’autres biens personnels ou domestiques n.c.a.</skos:altLabel>
	<skos:altLabel xml:lang="bg">Ремонт и поддържане на лични и домакински вещи, некласифицирани другаде</skos:altLabel>
	<skos:altLabel xml:lang="cs">Opravy a údržba výrobků pro osobní potřebu a převážně pro domácnost j. n.</skos:altLabel>
	<skos:altLabel xml:lang="da">Reparation og vedligeholdelse af varer til personlig brug og husholdningsbrug i.a.n.</skos:altLabel>
	<skos:altLabel xml:lang="el">Επισκευή και συντήρηση ειδών προσωπικής και οικιακής χρήσης π.δ.κ.α.</skos:altLabel>
	<skos:altLabel xml:lang="es">Reparación y mantenimiento de efectos personales y artículos de uso doméstico n.c.o.p.</skos:altLabel>
	<skos:altLabel xml:lang="et">Mujal liigitamata tarbeesemete ja kodutarvete parandus ja hooldus</skos:altLabel>
	<skos:altLabel xml:lang="fi">Muualla luokittelematon henkilökohtaisten ja taloustavaroiden korjaus ja huolto</skos:altLabel>
	<skos:altLabel xml:lang="ga">Deisiú agus cothabháil earraí pearsanta agus tí nach n-aicmítear in áit ar bith eile</skos:altLabel>
	<skos:altLabel xml:lang="hr">Popravak i održavanje predmeta za osobnu uporabu i kućanstvo, d.n.</skos:altLabel>
	<skos:altLabel xml:lang="hu">M.n.s. személyi, háztartási cikk javítása, karbantartása</skos:altLabel>
	<skos:altLabel xml:lang="it">Riparazione e manutenzione di beni per uso personale e per la casa n.c.a.</skos:altLabel>
	<skos:altLabel xml:lang="lt">Niekur kitur nepriskirtų asmeninių ir namų ūkio reikmenų taisymas ir priežiūra</skos:altLabel>
	<skos:altLabel xml:lang="lv">Citur neklasificētu personīgas lietošanas un mājsaimniecības preču remonts un apkope</skos:altLabel>
	<skos:altLabel xml:lang="mt">Tiswija u manutenzjoni tal-oġġetti personali u domestiċi m.k.b.</skos:altLabel>
	<skos:altLabel xml:lang="nl">Reparatie en onderhoud van consumentenartikelen, n.e.g.</skos:altLabel>
	<skos:altLabel xml:lang="pt">Reparação e manutenção de bens de uso pessoal e doméstico, n.e.</skos:altLabel>
	<skos:altLabel xml:lang="ro">Repararea și întreținerea bunurilor personale și de uz casnic n.c.a.</skos:altLabel>
	<skos:altLabel xml:lang="sl">Popravila in vzdrževanje izdelkov za široko rabo, d. n.</skos:altLabel>
	<skos:altLabel xml:lang="sv">Reparation och underhåll av övriga hushållsartiklar och varor för personligt bruk</skos:altLabel>
	<skos:altLabel xml:lang="de">Reparatur und Instandhaltung von Gebrauchsgütern a. n. g.</skos:altLabel>
	<skos:altLabel xml:lang="pl">Naprawa i konserwacja artykułów użytku osobistego i domowego, gdzie indziej niesklasyfikowana</skos:altLabel>
	<skos:altLabel xml:lang="sk">Oprava a údržba osobných potrieb a potrieb pre domácnosti i. n.</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/953">
	<skos:altLabel xml:lang="en">Repair and maintenance of motor vehicles and motorcycles</skos:altLabel>
	<skos:altLabel xml:lang="fr">Réparation et entretien d’automobiles et de motocycles</skos:altLabel>
	<skos:altLabel xml:lang="bg">Ремонт и поддържане на автомобили и мотоциклети</skos:altLabel>
	<skos:altLabel xml:lang="cs">Opravy a údržba motorových vozidel a motocyklů</skos:altLabel>
	<skos:altLabel xml:lang="da">Reparation og vedligeholdelse af motorkøretøjer og motorcykler</skos:altLabel>
	<skos:altLabel xml:lang="el">Επισκευή και συντήρηση μηχανοκίνητων οχημάτων και μοτοσυκλετών</skos:altLabel>
	<skos:altLabel xml:lang="es">Reparación y mantenimiento de vehículos de motor y motocicletas</skos:altLabel>
	<skos:altLabel xml:lang="et">Mootorsõidukite ja mootorrataste remont ja hooldus</skos:altLabel>
	<skos:altLabel xml:lang="fi">Moottoriajoneuvojen ja moottoripyörien korjaus ja huolto</skos:altLabel>
	<skos:altLabel xml:lang="ga">Deisiú agus cothabháil mótarfheithiclí agus gluaisrothar</skos:altLabel>
	<skos:altLabel xml:lang="hr">Popravak i održavanje motornih vozila i motocikala</skos:altLabel>
	<skos:altLabel xml:lang="hu">Gépjármű, motorkerékpár javítása, karbantartása</skos:altLabel>
	<skos:altLabel xml:lang="it">Riparazione e manutenzione di autoveicoli e motocicli</skos:altLabel>
	<skos:altLabel xml:lang="lt">Variklinių transporto priemonių ir motociklų remontas ir techninė priežiūra</skos:altLabel>
	<skos:altLabel xml:lang="lv">Mehānisko transportlīdzekļu un motociklu remonts un apkope</skos:altLabel>
	<skos:altLabel xml:lang="mt">Tiswija u manutenzjoni tal-vetturi motorizzati u l-muturi</skos:altLabel>
	<skos:altLabel xml:lang="nl">Reparatie en onderhoud van motorvoertuigen en motorfietsen</skos:altLabel>
	<skos:altLabel xml:lang="pt">Reparação e manutenção de veículos automóveis e motociclos</skos:altLabel>
	<skos:altLabel xml:lang="ro">Repararea și întreținerea autovehiculelor și a motocicletelor</skos:altLabel>
	<skos:altLabel xml:lang="sl">Popravila in vzdrževanje motornih vozil in motornih koles</skos:altLabel>
	<skos:altLabel xml:lang="sv">Reparation och underhåll av motorfordon och motorcyklar</skos:altLabel>
	<skos:altLabel xml:lang="de">Reparatur und Instandhaltung von Kraftwagen und Krafträdern</skos:altLabel>
	<skos:altLabel xml:lang="pl">Naprawa i konserwacja pojazdów silnikowych, w tym motocykli</skos:altLabel>
	<skos:altLabel xml:lang="sk">Oprava a údržba motorových vozidiel a motocyklov</skos:altLabel>
</rdf:Description>

