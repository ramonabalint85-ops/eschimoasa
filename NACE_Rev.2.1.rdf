	<skos:altLabel xml:lang="et">Põllumajandustoorme ja elusloomade hulgimüük</skos:altLabel>
	<skos:altLabel xml:lang="fi">Maatalousperäisten raaka-aineiden ja elävien eläinten tukkukauppa</skos:altLabel>
