<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/256">
	<skos:altLabel xml:lang="en">Manufacture of cutlery, tools and general hardware</skos:altLabel>
	<skos:altLabel xml:lang="fr">Fabrication de coutellerie, d’outillage et de quincaillerie</skos:altLabel>
	<skos:altLabel xml:lang="bg">Производство на кухненски прибори, инструменти и железария</skos:altLabel>
	<skos:altLabel xml:lang="cs">Výroba nožířských výrobků, nástrojů a železářských výrobků</skos:altLabel>
	<skos:altLabel xml:lang="da">Fremstilling af bestik, skære- og klipperedskaber, håndværktøj og diverse metalprodukter</skos:altLabel>
	<skos:altLabel xml:lang="el">Κατασκευή μαχαιροπήρουνων, εργαλείων και σιδηρικών</skos:altLabel>
	<skos:altLabel xml:lang="es">Fabricación de artículos de cuchillería y cubertería, herramientas y ferretería</skos:altLabel>
	<skos:altLabel xml:lang="et">Lõike- ja tööriistade ning rauakaupade tootmine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Ruokailu- ja leikkuuvälineiden, työkalujen ja rautatavaran valmistus</skos:altLabel>
	<skos:altLabel xml:lang="ga">Monarú sceanra, uirlisí agus crua-earraí ginearálta</skos:altLabel>
	<skos:altLabel xml:lang="hr">Proizvodnja pribora za jelo i sječiva, alata i opće željezne robe</skos:altLabel>
	<skos:altLabel xml:lang="hu">Evőeszköz, szerszám, általános fémáru gyártása</skos:altLabel>
	<skos:altLabel xml:lang="it">Fabbricazione di articoli di coltelleria e posateria, utensili e oggetti di ferramenta</skos:altLabel>
	<skos:altLabel xml:lang="lt">Stalo ir kitų įrankių bei bendrųjų metalo dirbinių gamyba</skos:altLabel>
	<skos:altLabel xml:lang="lv">Galda piederumu, darbarīku un metāla izstrādājumu ražošana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Manifattura tal-pożati, l-għodod u ferramenta ġenerali</skos:altLabel>
	<skos:altLabel xml:lang="nl">Vervaardiging van scharen, messen, bestekken, gereedschap en ijzerwaren</skos:altLabel>
	<skos:altLabel xml:lang="pt">Fabricação de cutelaria, ferramentas e ferragens</skos:altLabel>
	<skos:altLabel xml:lang="ro">Fabricarea produselor de tăiat, a uneltelor și a articolelor de fierărie</skos:altLabel>
	<skos:altLabel xml:lang="sl">Proizvodnja jedilnega pribora, ključavnic, okovja, orodja</skos:altLabel>
	<skos:altLabel xml:lang="sv">Tillverkning av bestick, verktyg och andra järnhandelsvaror</skos:altLabel>
	<skos:altLabel xml:lang="de">Herstellung von Schneidwaren, Werkzeugen, Schlössern und Beschlägen aus unedlen Metallen</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja wyrobów nożowniczych, sztućców, narzędzi i wyrobów metalowych ogólnego przeznaczenia</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výroba nožiarskych výrobkov, náradia a železiarskeho tovaru</skos:altLabel>
</rdf:Description>

