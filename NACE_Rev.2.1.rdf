</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/2932">
	<skos:altLabel xml:lang="en">Manufacture of other parts and accessories for motor vehicles</skos:altLabel>
	<skos:altLabel xml:lang="fr">Fabrication d’autres équipements automobiles</skos:altLabel>
