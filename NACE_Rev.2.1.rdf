	<skos:prefLabel xml:lang="hr">46.14 Posredovanje u trgovini na veliko strojevima, industrijskom opremom, brodovima i zrakoplovima</skos:prefLabel>
	<skos:prefLabel xml:lang="hu">46.14 Gép, ipari berendezés, hajó, repülőgép ügynöki nagykereskedelme</skos:prefLabel>
