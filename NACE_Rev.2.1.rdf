<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/79">
	<skos:prefLabel xml:lang="en">79 Travel agency, tour operator and other reservation service and related activities</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">79 Activités d’agence de voyage, de voyagiste, de service de réservation et de services connexes</skos:prefLabel>
	<skos:prefLabel xml:lang="bg">79 Туристическа агентска и операторска дейност и други дейности, свързани с пътувания и резервации</skos:prefLabel>
