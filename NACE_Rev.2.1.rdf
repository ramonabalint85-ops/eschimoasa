<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/722">
	<skos:altLabel xml:lang="en">Research and experimental development on social sciences and humanities</skos:altLabel>
	<skos:altLabel xml:lang="fr">Recherche et développement en sciences humaines et sociales</skos:altLabel>
	<skos:altLabel xml:lang="bg">Научноизследователска и развойна дейност в областта на обществените и хуманитарните науки</skos:altLabel>
	<skos:altLabel xml:lang="cs">Výzkum a vývoj v oblasti společenských a humanitních věd</skos:altLabel>
	<skos:altLabel xml:lang="da">Forskning og eksperimentel udvikling inden for samfundsvidenskab og humanistiske videnskaber</skos:altLabel>
	<skos:altLabel xml:lang="el">Έρευνα και πειραματική ανάπτυξη στις κοινωνικές και ανθρωπιστικές επιστήμες</skos:altLabel>
	<skos:altLabel xml:lang="es">Investigación y desarrollo experimental en ciencias sociales y humanidades</skos:altLabel>
	<skos:altLabel xml:lang="et">Teadus- ja arendustegevus sotsiaal- ja humanitaarteaduste vallas</skos:altLabel>
	<skos:altLabel xml:lang="fi">Yhteiskuntatieteellinen ja humanistinen tutkimus ja kehittäminen</skos:altLabel>
	<skos:altLabel xml:lang="ga">Taighde agus forbairt thrialach ar eolaíochtaí sóisialta agus ar na daonnachtaí</skos:altLabel>
	<skos:altLabel xml:lang="hr">Istraživanje i eksperimentalni razvoj u društvenim i humanističkim znanostima</skos:altLabel>
	<skos:altLabel xml:lang="hu">Társadalomtudományi, humán kutatás, kísérleti fejlesztés</skos:altLabel>
	<skos:altLabel xml:lang="it">Ricerca e sviluppo sperimentale nel campo delle scienze sociali e umanistiche</skos:altLabel>
	<skos:altLabel xml:lang="lt">Socialinių ir humanitarinių mokslų moksliniai tyrimai ir taikomoji veikla</skos:altLabel>
	<skos:altLabel xml:lang="lv">Pētniecība un eksperimentālā izstrāde sociālajās un humanitārajās zinātnēs</skos:altLabel>
	<skos:altLabel xml:lang="mt">Riċerka u żvilupp esperimentali dwar ix-xjenzi soċjali u umanistiċi</skos:altLabel>
