<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/1039">
	<skos:altLabel xml:lang="en">Other processing and preserving of fruit and vegetables</skos:altLabel>
	<skos:altLabel xml:lang="fr">Autre transformation et conservation de fruits et légumes</skos:altLabel>
	<skos:altLabel xml:lang="bg">Преработка и консервиране на други плодове и зеленчуци, без готови ястия</skos:altLabel>
	<skos:altLabel xml:lang="cs">Ostatní zpracování a konzervování ovoce a zeleniny</skos:altLabel>
	<skos:altLabel xml:lang="da">Anden forarbejdning og konservering af frugt og grøntsager</skos:altLabel>
	<skos:altLabel xml:lang="el">Άλλη επεξεργασία και συντήρηση φρούτων και λαχανικών</skos:altLabel>
	<skos:altLabel xml:lang="es">Otro procesado y conservación de frutas y hortalizas</skos:altLabel>
	<skos:altLabel xml:lang="et">Muu puu- ja köögivilja töötlemine ja säilitamine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Muu kasvisten jalostus ja säilöntä</skos:altLabel>
	<skos:altLabel xml:lang="ga">Próiseáil agus leasú eile torthaí agus glasraí</skos:altLabel>
	<skos:altLabel xml:lang="hr">Ostala prerada i konzerviranje voća i povrća</skos:altLabel>
	<skos:altLabel xml:lang="hu">Egyéb gyümölcs-, zöldségfeldolgozás, -tartósítás</skos:altLabel>
	<skos:altLabel xml:lang="it">Altre attività di lavorazione e conservazione di frutta e ortaggi</skos:altLabel>
	<skos:altLabel xml:lang="lt">Kitas vaisių ir daržovių perdirbimas ir konservavimas</skos:altLabel>
	<skos:altLabel xml:lang="lv">Cita augļu un dārzeņu pārstrāde un konservēšana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Ipproċessar u preservazzjoni oħra tal-frott u l-ħaxix</skos:altLabel>
	<skos:altLabel xml:lang="nl">Overige verwerking en conservering van groenten en fruit</skos:altLabel>
	<skos:altLabel xml:lang="pt">Outro processamento e conservação de frutos e de produtos hortícolas</skos:altLabel>
	<skos:altLabel xml:lang="ro">Altă prelucrare și conservare a fructelor și legumelor</skos:altLabel>
	<skos:altLabel xml:lang="sl">Druga predelava in konzerviranje sadja in zelenjave</skos:altLabel>
