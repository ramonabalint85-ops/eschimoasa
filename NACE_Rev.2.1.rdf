	<skos:prefLabel xml:lang="it">15.11 Concia, tintura e rifinizione di pelli, cuoi e pellicce</skos:prefLabel>
	<skos:prefLabel xml:lang="lt">15.11 Odų ir kailių rauginimas, dažymas, išdirbimas</skos:prefLabel>
	<skos:prefLabel xml:lang="lv">15.11 Ādu un kažokādu miecēšana, apstrāde un krāsošana</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">15.11 Ikkunzar, irfinar, tiżbigħ tal-ġilda u l-fer</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">15.11 Looien, bereiden en verven van leder en bont</skos:prefLabel>
	<skos:prefLabel xml:lang="pl">15.11 Garbowanie, barwienie, wyprawa skór, w tym futerkowych</skos:prefLabel>
	<skos:prefLabel xml:lang="pt">15.11 Curtimento, acabamento e tingimento de couros e peles com pelo</skos:prefLabel>
	<skos:prefLabel xml:lang="ro">15.11 Tăbăcirea, finisarea, vopsirea pieilor și a blănurilor</skos:prefLabel>
	<skos:prefLabel xml:lang="sl">15.11 Strojenje in dodelava usnja in krzna</skos:prefLabel>
	<skos:prefLabel xml:lang="sv">15.11 Garvning och annan beredning av läder-, skinn- och pälsvaror</skos:prefLabel>
	<skos:prefLabel xml:lang="de">15.11 Gerben, Färben, Zurichten von Leder und Fellen</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">15.11 Činenie, apretovanie, farbenie kože a kožušín</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/1512">
	<skos:prefLabel xml:lang="en">15.12 Manufacture of luggage, handbags, saddlery and harness of any material</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">15.12 Fabrication de bagages, de maroquinerie, sellerie et bourrellerie, en toutes matières</skos:prefLabel>
	<skos:prefLabel xml:lang="bg">15.12 Производство на куфари, чанти и други изделия за пътуване, сарашки и седларски изделия от всякакви материали</skos:prefLabel>
	<skos:prefLabel xml:lang="cs">15.12 Výroba zavazadel, kabelek, sedlářských a řemenářských výrobků z jakýchkoli materiálů</skos:prefLabel>
	<skos:prefLabel xml:lang="da">15.12 Fremstilling af tasker, kufferter, sadelmagervarer mv., uanset materialets art</skos:prefLabel>
	<skos:prefLabel xml:lang="el">15.12 Κατασκευή ειδών ταξιδίου (αποσκευών), τσαντών, ειδών σελλοποιίας και σαγματοποιίας από οποιοδήποτε υλικό</skos:prefLabel>
	<skos:prefLabel xml:lang="es">15.12 Fabricación de artículos de marroquinería, viaje y de guarnicionería y talabartería de cualquier material</skos:prefLabel>
	<skos:prefLabel xml:lang="et">15.12 Mis tahes materjalist kohvrite, käekottide, sadulsepatoodete ja rakmete tootmine</skos:prefLabel>
	<skos:prefLabel xml:lang="fi">15.12 Matka- ja käsilaukkujen, satuloiden ja valjaiden valmistus mistä tahansa materiaalista</skos:prefLabel>
	<skos:prefLabel xml:lang="ga">15.12 Monarú bagáiste, málaí láimhe, diallaiteoireachta agus úmacha d’aon ábhar</skos:prefLabel>
	<skos:prefLabel xml:lang="hr">15.12 Proizvodnja putnih i ručnih torbi, sedlarskih i remenarskih proizvoda od bilo kojeg materijala</skos:prefLabel>
	<skos:prefLabel xml:lang="hu">15.12 Táskafélék, nyerges áru, szíjazat gyártása bármely anyagból</skos:prefLabel>
	<skos:prefLabel xml:lang="it">15.12 Fabbricazione di articoli da viaggio, borse, pelletteria e selleria di qualsiasi materiale</skos:prefLabel>
	<skos:prefLabel xml:lang="lt">15.12 Lagaminų, rankinių, balno reikmenų ir pakinktų gamyba iš bet kokių medžiagų</skos:prefLabel>
	<skos:prefLabel xml:lang="lv">15.12 Ceļojuma somu, rokassomu, zirglietu un iejūgu ražošana no jebkāda materiāla</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">15.12 Manifattura tal-bagalji, l-basktijiet, l-oġġetti tas-sarraġ u x-xedd ta’ kwalunkwe materjal</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">15.12 Vervaardiging van koffers, tassen, zadel- en tuigmakerswerk van ongeacht welk materiaal</skos:prefLabel>
	<skos:prefLabel xml:lang="pt">15.12 Fabricação de artigos de viagem, bolsas, marroquinaria, arreios e selas de qualquer material</skos:prefLabel>
	<skos:prefLabel xml:lang="ro">15.12 Fabricarea articolelor de voiaj și marochinărie și a harnașamentelor din orice material</skos:prefLabel>
	<skos:prefLabel xml:lang="sl">15.12 Proizvodnja potovalne galanterije in sedlarskih izdelkov iz katerega koli materiala</skos:prefLabel>
	<skos:prefLabel xml:lang="sv">15.12 Tillverkning av reseffekter, handväskor, sadel- och seldon oavsett material</skos:prefLabel>
	<skos:prefLabel xml:lang="de">15.12 Herstellung von Reisegepäck, Handtaschen, Sattlerwaren und Geschirren aus Stoffen aller Art</skos:prefLabel>
	<skos:prefLabel xml:lang="pl">15.12 Produkcja toreb bagażowych, toreb ręcznych i podobnych wyrobów kaletniczych; produkcja wyrobów rymarskich z dowolnego materiału</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">15.12 Výroba kufrov, kabeliek, sediel a popruhov z akéhokoľvek materiálu</skos:prefLabel>
</rdf:Description>

