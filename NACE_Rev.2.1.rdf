<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/241">
	<skos:altLabel xml:lang="en">Manufacture of basic iron and steel and of ferro-alloys</skos:altLabel>
	<skos:altLabel xml:lang="fr">Sidérurgie</skos:altLabel>
	<skos:altLabel xml:lang="bg">Производство на чугун, стомана и феросплави</skos:altLabel>
	<skos:altLabel xml:lang="cs">Výroba surového železa, oceli a feroslitin</skos:altLabel>
	<skos:altLabel xml:lang="da">Fremstilling af råjern og råstål samt jernlegeringer</skos:altLabel>
	<skos:altLabel xml:lang="el">Παραγωγή βασικού σιδήρου και χάλυβα και σιδηροκραμάτων</skos:altLabel>
	<skos:altLabel xml:lang="es">Fabricación de productos básicos de hierro, acero y ferroaleaciones</skos:altLabel>
	<skos:altLabel xml:lang="et">Raua, terase ja ferrosulamite tootmine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Raudan, teräksen ja rautaseosten valmistus</skos:altLabel>
	<skos:altLabel xml:lang="ga">Monarú buniarainn agus bunchruach agus fearó-chóimhiotal</skos:altLabel>
	<skos:altLabel xml:lang="hr">Proizvodnja sirovog željeza, čelika i ferolegura</skos:altLabel>
	<skos:altLabel xml:lang="hu">Vas, acél, vasötvözet alapanyag gyártása</skos:altLabel>
	<skos:altLabel xml:lang="it">Fabbricazione di ferro, acciaio e ferroleghe</skos:altLabel>
	<skos:altLabel xml:lang="lt">Tomo ketaus ir plieno bei ferolydinių gamyba</skos:altLabel>
	<skos:altLabel xml:lang="lv">Čuguna, tērauda un dzelzs sakausējumu ražošana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Manifattura tal-ħadid u l-azzar bażiċi u tal-ligi tal-ħadid</skos:altLabel>
	<skos:altLabel xml:lang="nl">Vervaardiging van ijzer en staal en van ferrolegeringen</skos:altLabel>
	<skos:altLabel xml:lang="pt">Siderurgia e fabricação de ferroligas</skos:altLabel>
	<skos:altLabel xml:lang="ro">Producția de metale feroase sub forme primare și de feroaliaje</skos:altLabel>
	<skos:altLabel xml:lang="sl">Proizvodnja surovega železa, jekla, ferozlitin</skos:altLabel>
	<skos:altLabel xml:lang="sv">Framställning av järn och stål samt ferrolegeringar</skos:altLabel>
	<skos:altLabel xml:lang="de">Erzeugung von Roheisen, Stahl und Ferrolegierungen</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja surówki żelazostopów, żeliwa i stali oraz wyrobów hutniczych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výroba surového železa, ocele a ferozliatin</skos:altLabel>
</rdf:Description>

