	<skos:altLabel xml:lang="hu">Vízi szállítóeszköz kölcsönzése</skos:altLabel>
	<skos:altLabel xml:lang="it">Noleggio e leasing operativo di mezzi di trasporto marittimi, fluviali e lacustri</skos:altLabel>
	<skos:altLabel xml:lang="lt">Vandens transporto įrangos nuoma ir išperkamoji nuoma</skos:altLabel>
	<skos:altLabel xml:lang="lv">Ūdens transportlīdzekļu iznomāšana un ekspluatācijas līzings</skos:altLabel>
	<skos:altLabel xml:lang="mt">Kiri u lokazzjoni ta’ tagħmir tat-trasport fuq l-ilma</skos:altLabel>
	<skos:altLabel xml:lang="nl">Verhuur en lease van schepen</skos:altLabel>
