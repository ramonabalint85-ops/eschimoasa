<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/682">
	<skos:altLabel xml:lang="en">Rental and operating of own or leased real estate</skos:altLabel>
	<skos:altLabel xml:lang="fr">Location et exploitation de biens immobiliers propres ou loués</skos:altLabel>
	<skos:altLabel xml:lang="bg">Даване под наем и експлоатация на собствени недвижими имоти</skos:altLabel>
	<skos:altLabel xml:lang="cs">Pronájem a správa vlastních nebo pronajatých nemovitostí</skos:altLabel>
	<skos:altLabel xml:lang="da">Udlejning af og aktiviteter i forbindelse med egen eller leaset fast ejendom</skos:altLabel>
	<skos:altLabel xml:lang="el">Εκμίσθωση και διαχείριση ιδιόκτητων ή μισθωμένων ακινήτων</skos:altLabel>
	<skos:altLabel xml:lang="es">Alquiler de bienes inmobiliarios por cuenta propia</skos:altLabel>
	<skos:altLabel xml:lang="et">Enda või renditud kinnisvara üürileandmine ja käitus</skos:altLabel>
	<skos:altLabel xml:lang="fi">Omien tai leasing-kiinteistöjen vuokraus ja hallinta</skos:altLabel>
	<skos:altLabel xml:lang="ga">Eastát réadach féin nó eastát réadach léasaithe a ligean ar cíos agus a oibriú</skos:altLabel>
	<skos:altLabel xml:lang="hr">Iznajmljivanje i upravljanje vlastitim nekretninama ili nekretninama uzetim u zakup (leasing)</skos:altLabel>
