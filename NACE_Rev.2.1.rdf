	<skos:prefLabel xml:lang="mt">77.52 Attivitajiet ta’ servizz ta’ intermedjazzjoni għall-kiri u l-lokazzjoni ta’ oġġetti tanġibbli u assi intanġibbli nonfinanzjarji oħra</skos:prefLabel>
