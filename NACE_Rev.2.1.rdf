	<skos:altLabel xml:lang="lv">Iekārtu un ierīču remonts, apkope un uzstādīšana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Tiswija, manutenzjoni u installazzjoni tal-makkinarju u tat-tagħmir</skos:altLabel>
