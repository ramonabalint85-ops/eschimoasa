</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/02">
	<xkos:exclusionNote xml:lang="en">Excluded is further processing of wood beginning with sawmilling and planing of wood, see division 16.</xkos:exclusionNote>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/0210">
	<xkos:exclusionNote xml:lang="en">This class excludes:
- growing of Christmas trees, see 01.29
