	<skos:altLabel xml:lang="et">Muu kirjastamine, v.a tarkvara kirjastamine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Muu kustannustoiminta pois lukien ohjelmistojen kustantaminen</skos:altLabel>
