	<skos:prefLabel xml:lang="de">95.1 Reparatur und Instandhaltung von Datenverarbeitungs- und Telekommunikationsgeräten</skos:prefLabel>
	<skos:prefLabel xml:lang="pl">95.1 Naprawa i konserwacja komputerów i sprzętu (tele)komunikacyjnego</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">95.1 Oprava a údržba počítačov a komunikačných zariadení</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/9510">
	<skos:prefLabel xml:lang="en">95.10 Repair and maintenance of computers and communication equipment</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">95.10 Réparation et entretien d’ordinateurs et d’équipements de communication</skos:prefLabel>
	<skos:prefLabel xml:lang="bg">95.10 Ремонт и поддържане на компютърна и комуникационна техника</skos:prefLabel>
