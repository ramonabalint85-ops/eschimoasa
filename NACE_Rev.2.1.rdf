	<skos:altLabel xml:lang="es">Otras industrias extractivas n.c.o.p.</skos:altLabel>
	<skos:altLabel xml:lang="et">Muu mujal liigitamata kaevandamine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Muu muualla luokittelematon kaivostoiminta ja louhinta</skos:altLabel>
	<skos:altLabel xml:lang="ga">Mianadóireacht agus cairéalacht eile nach n-aicmítear in áit ar bith eile</skos:altLabel>
	<skos:altLabel xml:lang="hr">Ostalo rudarstvo i vađenje, d.n.</skos:altLabel>
	<skos:altLabel xml:lang="hu">Egyéb m.n.s. bányászat</skos:altLabel>
	<skos:altLabel xml:lang="it">Altre attività estrattive n.c.a.</skos:altLabel>
