<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/6612">
	<skos:altLabel xml:lang="en">Security and commodity contracts brokerage</skos:altLabel>
	<skos:altLabel xml:lang="fr">Courtage de valeurs mobilières et de matières premières</skos:altLabel>
	<skos:altLabel xml:lang="bg">Посредническа дейност по сделки с ценни книжа и стоки</skos:altLabel>
	<skos:altLabel xml:lang="cs">Obchodování s cennými papíry a komoditami na burzách</skos:altLabel>
