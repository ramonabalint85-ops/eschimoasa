<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/0899">
	<skos:altLabel xml:lang="en">Other mining and quarrying n.e.c.</skos:altLabel>
	<skos:altLabel xml:lang="fr">Autres activités extractives n.c.a.</skos:altLabel>
	<skos:altLabel xml:lang="bg">Добив на други неметални материали и суровини, некласифицирани другаде</skos:altLabel>
	<skos:altLabel xml:lang="cs">Těžba a dobývání ostatních nerostných surovin j. n.</skos:altLabel>
	<skos:altLabel xml:lang="da">Anden råstofindvinding i.a.n.</skos:altLabel>
