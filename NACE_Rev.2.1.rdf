	<skos:altLabel xml:lang="sv">Tillverkning av hushålls- och hygienartiklar av papper</skos:altLabel>
	<skos:altLabel xml:lang="de">Herstellung von Haushalts-, Hygiene- und Toilettenartikeln aus Zellstoff, Papier und Pappe</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja artykułów gospodarstwa domowego, toaletowych i sanitarnych</skos:altLabel>
