	<skos:altLabel xml:lang="ro">Fabricarea lagărelor, angrenajelor, cutiilor de viteză și a elementelor mecanice de transmisie</skos:altLabel>
	<skos:altLabel xml:lang="sl">Proizvodnja ležajev, zobnikov in elementov za mehanski prenos energije</skos:altLabel>
	<skos:altLabel xml:lang="sv">Tillverkning av lager, kugghjul och andra delar för kraftöverföring</skos:altLabel>
	<skos:altLabel xml:lang="de">Herstellung von Lagern, Getrieben, Zahnrädern und Antriebselementen</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja łożysk, kół zębatych, przekładni zębatych i elementów napędowych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výroba ložísk, ozubených kolies, prevodových a ovládacích prvkov</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/282">
	<skos:altLabel xml:lang="en">Manufacture of other general-purpose machinery</skos:altLabel>
	<skos:altLabel xml:lang="ga">Monarú innealra ilchuspóirigh eile</skos:altLabel>
