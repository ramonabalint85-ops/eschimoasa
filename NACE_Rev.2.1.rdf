	<skos:altLabel xml:lang="es">Fabricación de instrumentos de verificación de medidas y relojes</skos:altLabel>
	<skos:altLabel xml:lang="et">Mõõte- ja katseseadmete ning ajanäitajate tootmine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Mittaus- ja testauslaitteiden ja kellojen valmistus</skos:altLabel>
	<skos:altLabel xml:lang="ga">Monarú uirlisí tástála tomhais, clog agus uaireadóirí</skos:altLabel>
	<skos:altLabel xml:lang="hr">Proizvodnja mjernih instrumenata za ispitivanje i satova</skos:altLabel>
	<skos:altLabel xml:lang="hu">Műszer-, óragyártás</skos:altLabel>
	<skos:altLabel xml:lang="it">Fabbricazione di strumenti di misurazione e prova e di orologi</skos:altLabel>
	<skos:altLabel xml:lang="lt">Matavimo, bandymo prietaisų ir įvairių tipų laikrodžių gamyba</skos:altLabel>
	<skos:altLabel xml:lang="lv">Mērīšanas, pārbaudes instrumentu un pulksteņu ražošana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Manifattura tal-istrumenti tal-ittestjar u tal-kejl, l-arloġġi u l-arloġġi tal-id</skos:altLabel>
	<skos:altLabel xml:lang="nl">Vervaardiging van meet-en controle-instrumenten, klokken en horloges</skos:altLabel>
	<skos:altLabel xml:lang="pt">Fabricação de instrumentos de medição e verificação, relógios e material de relojoaria</skos:altLabel>
	<skos:altLabel xml:lang="ro">Fabricarea de instrumente de măsură, verificare și control, orologii și ceasuri</skos:altLabel>
	<skos:altLabel xml:lang="sl">Proizvodnja merilnih in preizkuševalnih instrumentov ter ur</skos:altLabel>
	<skos:altLabel xml:lang="sv">Tillverkning av instrument för mätning och provning samt ur</skos:altLabel>
	<skos:altLabel xml:lang="de">Herstellung von Mess- und Kontrollinstrumenten sowie von Uhren</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja instrumentów i przyrządów pomiarowych, kontrolnych, zegarów i zegarków</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výroba nástrojov na meranie a testovanie, hodín a hodiniek</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/2651">
	<skos:altLabel xml:lang="en">Manufacture of instruments and appliances for measuring, testing and navigation</skos:altLabel>
	<skos:altLabel xml:lang="fr">Fabrication d’instruments et d’appareils de mesure, d’essai et de navigation</skos:altLabel>
	<skos:altLabel xml:lang="bg">Производство на уреди и апарати за измерване, изпитване и навигация</skos:altLabel>
	<skos:altLabel xml:lang="cs">Výroba měřicích, zkušebních a navigačních přístrojů</skos:altLabel>
	<skos:altLabel xml:lang="da">Fremstilling af instrumenter og udstyr til måling, afprøvning og navigation</skos:altLabel>
	<skos:altLabel xml:lang="el">Κατασκευή οργάνων και συσκευών μέτρησης, δοκιμών και πλοήγησης</skos:altLabel>
	<skos:altLabel xml:lang="es">Fabricación de instrumentos y aparatos de medida, verificación y navegación</skos:altLabel>
	<skos:altLabel xml:lang="et">Mõõte-, katse- ja navigatsiooniseadmete tootmine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Mittaus-, testaus- ja navigointivälineiden ja -laitteiden valmistus</skos:altLabel>
	<skos:altLabel xml:lang="ga">Monarú ionstraimí agus fearas do thomhas, tástáil agus nascleanúint</skos:altLabel>
	<skos:altLabel xml:lang="hr">Proizvodnja instrumenata i aparata za mjerenje, ispitivanje i navigaciju</skos:altLabel>
	<skos:altLabel xml:lang="hu">Mérőműszergyártás</skos:altLabel>
	<skos:altLabel xml:lang="it">Fabbricazione di strumenti e apparecchi di misurazione, prova e navigazione</skos:altLabel>
	<skos:altLabel xml:lang="lt">Matavimo, bandymo, navigacinės ir kontrolės įrangos prietaisų ir aparatų gamyba</skos:altLabel>
	<skos:altLabel xml:lang="lv">Mērīšanas, pārbaudes, izmēģināšanas un navigācijas instrumentu un aparātu ražošana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Manifattura tal-istrumenti u l-apparati tal-kejl, tal-ittestjar, u tan-navigazzjoni</skos:altLabel>
	<skos:altLabel xml:lang="nl">Vervaardiging van meet-, controle- en navigatie-instrumenten en -apparatuur</skos:altLabel>
	<skos:altLabel xml:lang="pt">Fabricação de instrumentos e aparelhos de medição, verificação e navegação</skos:altLabel>
	<skos:altLabel xml:lang="ro">Fabricarea de instrumente și dispozitive pentru măsură, verificare, control, navigație</skos:altLabel>
	<skos:altLabel xml:lang="sl">Proizvodnja merilnih, preizkuševalnih in navigacijskih instrumentov in naprav</skos:altLabel>
	<skos:altLabel xml:lang="sv">Tillverkning av instrument och apparater för mätning, provning och navigering</skos:altLabel>
	<skos:altLabel xml:lang="de">Herstellung von Mess-, Kontroll-, Navigations- u. Ä. Instrumenten und Vorrichtungen</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja instrumentów i przyrządów pomiarowych, kontrolnych i nawigacyjnych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výroba nástrojov a zariadení na meranie, testovanie a navigovanie</skos:altLabel>
</rdf:Description>

