	<skos:prefLabel xml:lang="pl">90.39 Pozostała działalność wspomagająca działalność twórczą i działalność związaną z wystawianiem przedstawień artystycznych</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">90.39 Ostatné podporné činnosti súvisiace s umeleckou a scénickou tvorbou</skos:prefLabel>
</rdf:Description>

