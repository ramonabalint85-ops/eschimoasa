	<skos:altLabel xml:lang="sl">Radijska in televizijska dejavnost, dejavnost tiskovnih agencij in druge dejavnosti distribucije vsebin</skos:altLabel>
	<skos:altLabel xml:lang="sv">Planering, radio- och tv-sändning, nyhetsbyråer och annan distribution av medieinnehåll</skos:altLabel>
