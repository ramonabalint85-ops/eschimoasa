	<skos:altLabel xml:lang="lv">Cita citur neklasificēta ieguves rūpniecība un karjeru izstrāde</skos:altLabel>
	<skos:altLabel xml:lang="mt">Estrazzjonijiet mill-minjieri u tqattigħ mill-barrieri oħra m.k.b.</skos:altLabel>
	<skos:altLabel xml:lang="nl">Overige winning van delfstoffen, n.e.g.</skos:altLabel>
	<skos:altLabel xml:lang="pt">Outras indústrias extrativas, n.e.</skos:altLabel>
	<skos:altLabel xml:lang="ro">Alte activități extractive și de exploatare n.c.a.</skos:altLabel>
	<skos:altLabel xml:lang="sl">Drugo pridobivanje rudnin in kamnin, d. n.</skos:altLabel>
	<skos:altLabel xml:lang="sv">Diverse övrig utvinning av mineral</skos:altLabel>
