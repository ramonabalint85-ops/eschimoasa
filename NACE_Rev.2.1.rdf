<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/681">
	<skos:altLabel xml:lang="en">Real estate activities with own property and development of building projects</skos:altLabel>
	<skos:altLabel xml:lang="fr">Activités immobilières avec biens propres et promotion de projets immobiliers</skos:altLabel>
	<skos:altLabel xml:lang="bg">Операции със собствени недвижими имоти и дейности по реализиране на инвестиционни проекти за сгради</skos:altLabel>
	<skos:altLabel xml:lang="cs">Činnosti v oblasti vlastních nemovitostí a developerské činnosti</skos:altLabel>
	<skos:altLabel xml:lang="da">Aktiviteter i forbindelse med egen fast ejendom og gennemførelse af byggeprojekter</skos:altLabel>
	<skos:altLabel xml:lang="el">Διαχείριση ιδιόκτητων ακινήτων και ανάπτυξη οικοδομικών σχεδίων</skos:altLabel>
	<skos:altLabel xml:lang="es">Actividades inmobiliarias por cuenta propia y promoción inmobiliaria</skos:altLabel>
	<skos:altLabel xml:lang="et">Kinnisvaraalane tegevus ja kinnisvaraprojektide arendamine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Omiin kiinteistöihin liittyvä kiinteistöalan toiminta ja rakennushankkeiden kehittäminen</skos:altLabel>
	<skos:altLabel xml:lang="ga">Gníomhaíochtaí eastáit réadaigh le maoin an duine féin agus forbairt tionscadal tógála</skos:altLabel>
	<skos:altLabel xml:lang="hr">Kupnja i prodaja vlastitih nekretnina i organizacija izvedbe projekata za zgrade</skos:altLabel>
	<skos:altLabel xml:lang="hu">Ingatlanügylet saját tulajdonú ingatlannal, ingatlanfejlesztés</skos:altLabel>
	<skos:altLabel xml:lang="it">Attività immobiliari su beni propri e sviluppo di progetti immobiliari</skos:altLabel>
	<skos:altLabel xml:lang="lt">Nuosavo nekilnojamojo turto operacijos ir statybų projektų plėtra</skos:altLabel>
	<skos:altLabel xml:lang="lv">Operācijas ar savu nekustamo īpašumu un būvniecības projektu attīstīšana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Attivitajiet tal-proprjetà immobbli tal-individwu u żvilupp ta’ proġetti tal-bini</skos:altLabel>
	<skos:altLabel xml:lang="nl">Exploitatie van en handel in onroerend goed met eigen onroerend goed en ontwikkeling van bouwprojecten</skos:altLabel>
	<skos:altLabel xml:lang="pt">Atividades imobiliárias com bens imobiliários próprios e desenvolvimento de projetos de edifícios</skos:altLabel>
	<skos:altLabel xml:lang="ro">Cumpărarea și vânzarea bunurilor imobiliare proprii și dezvoltarea de proiecte imobiliare</skos:altLabel>
	<skos:altLabel xml:lang="sv">Fastighetsverksamhet med egna fastigheter och utformning av byggprojekt</skos:altLabel>
	<skos:altLabel xml:lang="de">Kauf und Verkauf von eigenen Grundstücken, Gebäuden und Wohnungen sowie Erschließung von Grundstücken</skos:altLabel>
	<skos:altLabel xml:lang="pl">Działalność związana z obsługą rynku nieruchomości na własny rachunek oraz realizacja projektów budowlanych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Činnosti v oblasti nehnuteľností s vlastným majetkom a vypracovanie stavebných projektov</skos:altLabel>
	<skos:altLabel xml:lang="sl">Poslovanje z lastnimi nepremičninami in organizacija izvedbe gradbenih projektov</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/6811">
	<skos:altLabel xml:lang="en">Buying and selling of own real estate</skos:altLabel>
	<skos:altLabel xml:lang="fr">Achat et vente de biens propres</skos:altLabel>
	<skos:altLabel xml:lang="bg">Покупка и продажба на собствени недвижими имоти</skos:altLabel>
	<skos:altLabel xml:lang="cs">Nákup a následný prodej vlastních nemovitostí</skos:altLabel>
	<skos:altLabel xml:lang="da">Køb og salg af egen fast ejendom</skos:altLabel>
	<skos:altLabel xml:lang="el">Αγοραπωλησία ιδιόκτητων ακινήτων</skos:altLabel>
	<skos:altLabel xml:lang="es">Compraventa de bienes inmobiliarios por cuenta propia</skos:altLabel>
	<skos:altLabel xml:lang="et">Enda kinnisvara ost ja müük</skos:altLabel>
	<skos:altLabel xml:lang="fi">Omien kiinteistöjen kauppa</skos:altLabel>
	<skos:altLabel xml:lang="ga">Ceannach agus díol eastáit réadaigh féin</skos:altLabel>
	<skos:altLabel xml:lang="hr">Kupnja i prodaja vlastitih nekretnina</skos:altLabel>
	<skos:altLabel xml:lang="hu">Saját tulajdonú ingatlan adásvétele</skos:altLabel>
	<skos:altLabel xml:lang="it">Compravendita di beni immobili effettuata su beni propri</skos:altLabel>
	<skos:altLabel xml:lang="lt">Nuosavo nekilnojamojo turto pirkimas ir pardavimas</skos:altLabel>
	<skos:altLabel xml:lang="lv">Sava nekustamā īpašuma pirkšana un pārdošana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Xiri u bejgħ tal-proprjetà immobbli tal-individwu</skos:altLabel>
	<skos:altLabel xml:lang="nl">Handel in eigen onroerend goed</skos:altLabel>
	<skos:altLabel xml:lang="pt">Compra e venda de bens imobiliários</skos:altLabel>
	<skos:altLabel xml:lang="ro">Cumpărarea și vânzarea bunurilor imobiliare proprii</skos:altLabel>
	<skos:altLabel xml:lang="sv">Handel med egna fastigheter</skos:altLabel>
	<skos:altLabel xml:lang="de">Kauf und Verkauf von eigenen Grundstücken, Gebäuden und Wohnungen</skos:altLabel>
	<skos:altLabel xml:lang="pl">Kupno i sprzedaż nieruchomości na własny rachunek</skos:altLabel>
	<skos:altLabel xml:lang="sk">Nákup a predaj vlastných nehnuteľností</skos:altLabel>
	<skos:altLabel xml:lang="sl">Trgovanje z lastnimi nepremičninami</skos:altLabel>
</rdf:Description>

