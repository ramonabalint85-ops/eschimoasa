<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/6619">
	<skos:altLabel xml:lang="en">Other activities auxiliary to financial services, except insurance and pension funding</skos:altLabel>
	<skos:altLabel xml:lang="fr">Autres activités auxiliaires de services financiers, hors assurance et fonds de pension</skos:altLabel>
	<skos:altLabel xml:lang="bg">Други спомагателни дейности във финансовите услуги, без застраховане и допълнително пенсионно осигуряване</skos:altLabel>
