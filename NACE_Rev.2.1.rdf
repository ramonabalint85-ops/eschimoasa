	<skos:altLabel xml:lang="pl">Badania naukowe i prace rozwojowe w dziedzinie nauk społecznych i humanistycznych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výskum a experimentálny vývoj v oblasti spoločenských a humanitných vied</skos:altLabel>
