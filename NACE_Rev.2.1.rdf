<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/202">
	<skos:altLabel xml:lang="en">Manufacture of pesticides, disinfectants and other agrochemical products</skos:altLabel>
	<skos:altLabel xml:lang="fr">Fabrication de pesticides, de désinfectants et d’autres produits agrochimiques</skos:altLabel>
