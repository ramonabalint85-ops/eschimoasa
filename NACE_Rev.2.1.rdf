	<skos:altLabel xml:lang="hu">Fürdő-, szauna-, gőzfürdő-szolgáltatás</skos:altLabel>
	<skos:altLabel xml:lang="it">Servizi di centri benessere, sauna e bagno di vapore</skos:altLabel>
	<skos:altLabel xml:lang="lt">Dienos SPA centrų ir įvairių tipų pirčių veikla</skos:altLabel>
	<skos:altLabel xml:lang="lv">Dienas spa, saunu un tvaika pirts darbība</skos:altLabel>
	<skos:altLabel xml:lang="mt">Attivitajiet ta’ spa ta’ matul il-jum, sawna u banju bil-fwar</skos:altLabel>
	<skos:altLabel xml:lang="nl">Activiteiten van kuuroorden, sauna’s en stoombaden</skos:altLabel>
	<skos:altLabel xml:lang="pt">Atividades de centros de bem-estar, saunas e banhos de vapor</skos:altLabel>
