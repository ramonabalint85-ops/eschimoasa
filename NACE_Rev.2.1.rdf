	<skos:altLabel xml:lang="ga">Gníomhaíochtaí teaghlach mar fhostóirí pearsanra tí</skos:altLabel>
	<skos:altLabel xml:lang="hr">Djelatnosti kućanstava koja zapošljavaju poslugu</skos:altLabel>
	<skos:altLabel xml:lang="hu">Háztartási alkalmazottat foglalkoztató magánháztartás</skos:altLabel>
