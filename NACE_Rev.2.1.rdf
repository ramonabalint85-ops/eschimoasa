	<skos:altLabel xml:lang="hu">Gépi meghajtású hordozható kézi szerszámgép gyártása</skos:altLabel>
	<skos:altLabel xml:lang="it">Fabbricazione di utensili portatili a motore</skos:altLabel>
	<skos:altLabel xml:lang="lt">Variklinių rankinių įrankių gamyba</skos:altLabel>
	<skos:altLabel xml:lang="lv">Mehāniskās piedziņas rokas darbarīku ražošana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Manifattura tal-għodod tal-id motorizzati</skos:altLabel>
	<skos:altLabel xml:lang="nl">Vervaardiging van elektrisch handgereedschap</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja narzędzi ręcznych mechanicznych</skos:altLabel>
	<skos:altLabel xml:lang="pt">Fabricação de máquinas-ferramentas portáteis com motor</skos:altLabel>
	<skos:altLabel xml:lang="ro">Fabricarea mașinilor-unelte portabile acționate electric</skos:altLabel>
	<skos:altLabel xml:lang="sl">Proizvodnja ročnih strojev in naprav</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výroba ručného náradia na mechanický pohon</skos:altLabel>
	<skos:altLabel xml:lang="sv">Tillverkning av motordrivna handverktyg</skos:altLabel>
	<skos:altLabel xml:lang="de">Herstellung von handgeführten Werkzeugen mit Motorantrieb</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/2825">
	<skos:altLabel xml:lang="en">Manufacture of non-domestic air conditioning equipment</skos:altLabel>
	<skos:altLabel xml:lang="fr">Fabrication d’équipements aérauliques et frigorifiques industriels</skos:altLabel>
	<skos:altLabel xml:lang="bg">Производство на промишлено климатично оборудване</skos:altLabel>
	<skos:altLabel xml:lang="cs">Výroba klimatizačních zařízení jiných než pro domácnost</skos:altLabel>
	<skos:altLabel xml:lang="da">Fremstilling af klimaanlæg, ikke til husholdningsbrug</skos:altLabel>
	<skos:altLabel xml:lang="el">Κατασκευή κλιματιστικού εξοπλισμού μη οικιακής χρήσης</skos:altLabel>
	<skos:altLabel xml:lang="es">Fabricación de equipos de aire acondicionado no domésticos</skos:altLabel>
	<skos:altLabel xml:lang="et">Tööstuslike kliimaseadmete tootmine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Muuhun kuin kotitalouskäyttöön tarkoitettujen ilmastointilaitteiden valmistus</skos:altLabel>
	<skos:altLabel xml:lang="ga">Monarú trealaimh aerchóiriúcháin nach trealamh tí é</skos:altLabel>
	<skos:altLabel xml:lang="hr">Proizvodnja rashladne i ventilacijske opreme, osim za kućanstva</skos:altLabel>
	<skos:altLabel xml:lang="hu">Nem háztartási légkondicionáló berendezés gyártása</skos:altLabel>
	<skos:altLabel xml:lang="it">Fabbricazione di apparecchiature di climatizzazione per uso non domestico</skos:altLabel>
	<skos:altLabel xml:lang="lt">Nebuitinių oro kondicionavimo įrenginių gamyba</skos:altLabel>
	<skos:altLabel xml:lang="lv">Rūpniecisku gaisa kondicionēšanas iekārtu ražošana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Manifattura tat-tagħmir mhux domestiku tal-arja kundizzjonata</skos:altLabel>
	<skos:altLabel xml:lang="nl">Vervaardiging van machines en apparaten voor klimaatregeling, voor niet-huishoudelijk gebruik</skos:altLabel>
	<skos:altLabel xml:lang="pt">Fabricação de equipamento não doméstico de ar condicionado</skos:altLabel>
	<skos:altLabel xml:lang="ro">Fabricarea echipamentelor de aer condiționat, altele decât cele de uz casnic</skos:altLabel>
	<skos:altLabel xml:lang="sl">Proizvodnja klimatskih naprav, razen za gospodinjstva</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výroba klimatizačných zariadení iných ako pre domácnosti</skos:altLabel>
	<skos:altLabel xml:lang="sv">Tillverkning av luftkonditionering, utom för hushåll</skos:altLabel>
	<skos:altLabel xml:lang="de">Herstellung von kälte- und lufttechnischen Erzeugnissen, nicht für den Haushalt</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja przemysłowych urządzeń chłodniczych, wentylacyjnych i klimatyzacyjnych</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/2829">
	<skos:altLabel xml:lang="en">Manufacture of other general-purpose machinery n.e.c.</skos:altLabel>
	<skos:altLabel xml:lang="fr">Fabrication de machines diverses d’usage général</skos:altLabel>
	<skos:altLabel xml:lang="bg">Производство на други машини с общо предназначение, некласифицирани другаде</skos:altLabel>
	<skos:altLabel xml:lang="cs">Výroba ostatních strojů a zařízení pro všeobecné účely j. n.</skos:altLabel>
	<skos:altLabel xml:lang="da">Fremstilling af andre maskiner til generelle formål i.a.n.</skos:altLabel>
	<skos:altLabel xml:lang="el">Κατασκευή άλλων μηχανημάτων γενικής χρήσης π.δ.κ.α.</skos:altLabel>
	<skos:altLabel xml:lang="es">Fabricación de otra maquinaria de uso general n.c.o.p.</skos:altLabel>
	<skos:altLabel xml:lang="et">Mujal liigitamata üldmasinate ja mehhanismide tootmine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Muualla luokittelematon muiden yleiskäyttöön tarkoitettujen koneiden valmistus</skos:altLabel>
	<skos:altLabel xml:lang="ga">Monarú innealra ilchuspóirigh eile nach n-aicmítear in áit ar bith eile</skos:altLabel>
	<skos:altLabel xml:lang="hr">Proizvodnja ostalih strojeva za opće namjene, d. n.</skos:altLabel>
	<skos:altLabel xml:lang="hu">M.n.s. egyéb általános rendeltetésű gép gyártása</skos:altLabel>
	<skos:altLabel xml:lang="it">Fabbricazione di altre macchine di impiego generale n.c.a.</skos:altLabel>
	<skos:altLabel xml:lang="lt">Kitų, niekur kitur nepriskirtų, bendrosios paskirties mašinų ir įrangos gamyba</skos:altLabel>
	<skos:altLabel xml:lang="lv">Citur neklasificētu universālu iekārtu ražošana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Manifattura ta’ makkinarju ieħor bi skop ġenerali m.k.b.</skos:altLabel>
	<skos:altLabel xml:lang="nl">Vervaardiging van andere machines en apparaten voor algemeen gebruik, n.e.g.</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja pozostałych maszyn ogólnego przeznaczenia, gdzie indziej niesklasyfikowana</skos:altLabel>
	<skos:altLabel xml:lang="pt">Fabricação de outras máquinas para uso geral, n.e.</skos:altLabel>
	<skos:altLabel xml:lang="ro">Fabricarea altor mașini și utilaje de utilizare generală n.c.a.</skos:altLabel>
	<skos:altLabel xml:lang="sl">Proizvodnja drugih strojev in naprav za splošne namene, d. n.</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výroba ostatných strojov na všeobecné účely i. n.</skos:altLabel>
