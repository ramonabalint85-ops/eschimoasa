<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/970">
	<skos:altLabel xml:lang="en">Activities of households as employers of domestic personnel</skos:altLabel>
	<skos:altLabel xml:lang="fr">Activités des ménages en tant qu’employeurs de personnel domestique</skos:altLabel>
