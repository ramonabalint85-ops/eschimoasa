<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/611">
	<skos:altLabel xml:lang="en">Wired, wireless, and satellite telecommunication activities</skos:altLabel>
	<skos:altLabel xml:lang="fr">Activités de télécommunications filaires, sans fil et satellitaires</skos:altLabel>
	<skos:altLabel xml:lang="bg">Далекосъобщителна дейност чрез фиксирани мрежи, по безжичен път и спътникова далекосъобщителна дейност</skos:altLabel>
	<skos:altLabel xml:lang="cs">Činnosti související s kabelovou, bezdrátovou a satelitní telekomunikační sítí</skos:altLabel>
	<skos:altLabel xml:lang="da">Levering af fastnetbaseret, trådløs og satellitbaseret telekommunikation</skos:altLabel>
	<skos:altLabel xml:lang="el">Ενσύρματες, ασύρματες και δορυφορικές τηλεπικοινωνίες</skos:altLabel>
	<skos:altLabel xml:lang="es">Actividades de telecomunicación por cable, inalámbricas y por satélite</skos:altLabel>
	<skos:altLabel xml:lang="et">Elektroonilise side teenused fikseeritud või traadita sidevõrgus ja satelliitsideteenused</skos:altLabel>
	<skos:altLabel xml:lang="fi">Kiinteän puhelinverkon ja langattoman verkon hallinta ja palvelut sekä satelliittiviestintä</skos:altLabel>
	<skos:altLabel xml:lang="ga">Gníomhaíochtaí teileachumarsáide sreangaithe, gan sreang agus teileachumarsáide satailíte</skos:altLabel>
	<skos:altLabel xml:lang="hr">Žičane, bežične i satelitske telekomunikacijske djelatnosti</skos:altLabel>
	<skos:altLabel xml:lang="hu">Vezetékes, vezeték nélküli és műholdas távközlés</skos:altLabel>
	<skos:altLabel xml:lang="it">Attività di telecomunicazioni fisse, mobili e satellitari</skos:altLabel>
	<skos:altLabel xml:lang="lt">Laidinio, bevielio ir palydovinio ryšio paslaugų veikla</skos:altLabel>
	<skos:altLabel xml:lang="lv">Kabeļu, bezvadu un satelītu telekomunikācijas pakalpojumi</skos:altLabel>
	<skos:altLabel xml:lang="mt">Attivitajiet tat-telekomunikazzjoni bil-fili, bla fili u bis-satellita</skos:altLabel>
	<skos:altLabel xml:lang="nl">Draadgebonden en draadloze telecommunicatie en telecommunicatie via satelliet</skos:altLabel>
	<skos:altLabel xml:lang="pt">Atividades de telecomunicações por fios, sem fios e por satélites</skos:altLabel>
	<skos:altLabel xml:lang="ro">Activități de telecomunicații cu fir, fără fir și prin satelit</skos:altLabel>
	<skos:altLabel xml:lang="sl">Telekomunikacijske dejavnosti po vodih, brezžične in satelitske telekomunikacijske dejavnosti</skos:altLabel>
	<skos:altLabel xml:lang="sv">Trådbunden och trådlös telekommunikation samt telekommunikation via satellit</skos:altLabel>
	<skos:altLabel xml:lang="de">Leitungsgebundene, drahtlose und satellitengestützte Telekommunikation</skos:altLabel>
	<skos:altLabel xml:lang="pl">Działalność w zakresie telekomunikacji przewodowej, bezprzewodowej i satelitarnej</skos:altLabel>
	<skos:altLabel xml:lang="sk">Činnosti drôtových, bezdrôtových a satelitných telekomunikácií</skos:altLabel>
</rdf:Description>

