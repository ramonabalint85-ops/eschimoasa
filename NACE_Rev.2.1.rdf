	<skos:altLabel xml:lang="sk">Prenájom a lízing vodných dopravných prostriedkov</skos:altLabel>
	<skos:altLabel xml:lang="sl">Dajanje vodnih plovil v najem in zakup</skos:altLabel>
</rdf:Description>

