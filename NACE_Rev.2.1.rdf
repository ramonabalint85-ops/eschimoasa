<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/66">
	<skos:altLabel xml:lang="en">Activities auxiliary to financial services and insurance activities</skos:altLabel>
	<skos:altLabel xml:lang="fr">Activités auxiliaires d’activités de services financiers et d’assurance</skos:altLabel>
	<skos:altLabel xml:lang="bg">Спомагателни дейности във финансовите услуги и застраховането</skos:altLabel>
	<skos:altLabel xml:lang="cs">Pomocné činnosti k finančním a pojišťovacím činnostem</skos:altLabel>
	<skos:altLabel xml:lang="da">Aktiviteter i forbindelse med finansielle tjenesteydelser og forsikringsaktiviteter</skos:altLabel>
	<skos:altLabel xml:lang="el">Δραστηριότητες συναφείς προς τις χρηματοπιστωτικές υπηρεσίες και τις ασφαλιστικές δραστηριότητες</skos:altLabel>
	<skos:altLabel xml:lang="es">Actividades auxiliares a los servicios financieros y a los seguros</skos:altLabel>
	<skos:altLabel xml:lang="et">Finantsteenuste ja kindlustustegevuse abitegevusalad</skos:altLabel>
