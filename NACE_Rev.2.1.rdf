	<skos:prefLabel xml:lang="ga">85.3 Meánoideachas agus oideachas iar-mheánscoile neamhthreasach</skos:prefLabel>
	<skos:prefLabel xml:lang="hr">85.3 Srednjoškolsko obrazovanje i obrazovanje nakon srednjoškolskog koje nije visoko</skos:prefLabel>
	<skos:prefLabel xml:lang="hu">85.3 Középfokú oktatás és középfok utáni nem felsőfokú oktatás</skos:prefLabel>
