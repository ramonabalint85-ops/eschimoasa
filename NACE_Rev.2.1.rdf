<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/20">
	<skos:altLabel xml:lang="en">Manufacture of chemicals and chemical products</skos:altLabel>
	<skos:altLabel xml:lang="fr">Industrie chimique</skos:altLabel>
	<skos:altLabel xml:lang="bg">Производство на химични продукти</skos:altLabel>
	<skos:altLabel xml:lang="cs">Výroba chemických látek a chemických výrobků</skos:altLabel>
	<skos:altLabel xml:lang="da">Fremstilling af kemiske produkter</skos:altLabel>
	<skos:altLabel xml:lang="el">Παραγωγή χημικών ουσιών και προϊόντων</skos:altLabel>
	<skos:altLabel xml:lang="es">Industria química</skos:altLabel>
	<skos:altLabel xml:lang="et">Kemikaalide ja keemiatoodete tootmine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Kemikaalien ja kemiallisten tuotteiden valmistus</skos:altLabel>
	<skos:altLabel xml:lang="ga">Monarú ceimiceán agus táirgí ceimiceacha</skos:altLabel>
	<skos:altLabel xml:lang="hr">Proizvodnja kemikalija i kemijskih proizvoda</skos:altLabel>
	<skos:altLabel xml:lang="hu">Vegyi anyag, termék gyártása</skos:altLabel>
	<skos:altLabel xml:lang="it">Fabbricazione di prodotti chimici</skos:altLabel>
	<skos:altLabel xml:lang="lt">Chemikalų ir chemijos produktų gamyba</skos:altLabel>
	<skos:altLabel xml:lang="lv">Ķīmisku vielu un ķīmisku produktu ražošana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Manifattura tas-sustanzi kimiċi u tal-prodotti kimiċi</skos:altLabel>
	<skos:altLabel xml:lang="nl">Vervaardiging van chemische producten</skos:altLabel>
	<skos:altLabel xml:lang="pt">Fabricação de produtos químicos e de fibras sintéticas e artificiais</skos:altLabel>
	<skos:altLabel xml:lang="ro">Fabricarea substanțelor și a produselor chimice</skos:altLabel>
	<skos:altLabel xml:lang="sl">Proizvodnja kemikalij in kemičnih izdelkov</skos:altLabel>
	<skos:altLabel xml:lang="sv">Tillverkning av kemikalier och kemiska produkter</skos:altLabel>
	<skos:altLabel xml:lang="de">Herstellung von chemischen Erzeugnissen</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja chemikaliów i wyrobów chemicznych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výroba chemikálií a chemických produktov</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/201">
	<skos:altLabel xml:lang="en">Manufacture of basic chemicals, fertilisers and nitrogen compounds, plastics and synthetic rubber in primary forms</skos:altLabel>
	<skos:altLabel xml:lang="fr">Fabrication de produits chimiques de base, de produits azotés et d’engrais, de matières plastiques de base et de caoutchouc synthétique</skos:altLabel>
	<skos:altLabel xml:lang="bg">Производство на основни химични вещества</skos:altLabel>
	<skos:altLabel xml:lang="cs">Výroba základních chemických látek, hnojiv a dusíkatých sloučenin, plastů a syntetického kaučuku v primárních formách</skos:altLabel>
	<skos:altLabel xml:lang="da">Fremstilling af basiskemikalier, gødningsstoffer og nitrogenprodukter, plast og syntetisk gummi i ubearbejdet form</skos:altLabel>
	<skos:altLabel xml:lang="el">Παραγωγή βασικών χημικών προϊόντων, λιπασμάτων και αζωτούχων ενώσεων, πλαστικών και συνθετικών υλών σε πρωτογενείς μορφές</skos:altLabel>
	<skos:altLabel xml:lang="es">Fabricación de productos químicos básicos, compuestos nitrogenados, fertilizantes, plásticos y caucho sintético en formas primarias</skos:altLabel>
	<skos:altLabel xml:lang="et">Põhikemikaalide, väetise ja lämmastikuühendite tootmine; plasti ja sünteeskautšuki tootmine algkujul</skos:altLabel>
	<skos:altLabel xml:lang="fi">Peruskemikaalien, lannoitteiden ja typpiyhdisteiden, muoviaineiden ja synteettisen kumiraaka-aineen valmistus</skos:altLabel>
	<skos:altLabel xml:lang="ga">Monarú ceimiceán bunúsach, leasúchán agus comhdhúl nítrigine, plaisteach agus rubair shintéisigh i bhfoirmeacha príomhúla</skos:altLabel>
	<skos:altLabel xml:lang="hr">Proizvodnja osnovnih kemikalija, gnojiva i dušičnih spojeva, plastike i sintetičkoga kaučuka u primarnim oblicima</skos:altLabel>
	<skos:altLabel xml:lang="hu">Vegyi alapanyag gyártása</skos:altLabel>
	<skos:altLabel xml:lang="it">Fabbricazione di prodotti chimici di base, di fertilizzanti e composti azotati, di materie plastiche e gomma sintetica in forme primarie</skos:altLabel>
	<skos:altLabel xml:lang="lt">Pagrindinių chemikalų, trąšų ir azoto junginių, pirminių plastikų ir pirminio sintetinio kaučiuko gamyba</skos:altLabel>
	<skos:altLabel xml:lang="lv">Ķīmisko pamatvielu, minerālmēslu un slāpekļa savienojumu, plastmasu un sintētiskā kaučuka ražošana pirmformās</skos:altLabel>
	<skos:altLabel xml:lang="mt">Manifattura tas-sustanzi kimiċi bażiċi, tal-fertilizzanti u tal-komposti tan-nitroġenu, il-plastik u l-lastku sintetiku f’forom primarji</skos:altLabel>
	<skos:altLabel xml:lang="nl">Vervaardiging van chemische basisproducten, kunstmeststoffen en stikstofverbindingen en van kunststoffen en synthetische rubber in primaire vormen</skos:altLabel>
	<skos:altLabel xml:lang="pt">Fabricação de produtos químicos de base, adubos e compostos azotados, matérias plásticas e borracha sintética sob formas primárias</skos:altLabel>
	<skos:altLabel xml:lang="ro">Fabricarea produselor chimice de bază, a îngrășămintelor și produselor azotoase, a materialelor plastice și a cauciucului sintetic în forme primare</skos:altLabel>
	<skos:altLabel xml:lang="sv">Tillverkning av baskemikalier, gödselmedel och kväveprodukter, plaster och syntetgummi i obearbetad form</skos:altLabel>
	<skos:altLabel xml:lang="de">Herstellung von chemischen Grundstoffen, Düngemitteln und Stickstoffverbindungen, Kunststoffen in Primärformen und synthetischem Kautschuk in Primärformen</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja podstawowych chemikaliów, nawozów i związków azotowych, tworzyw sztucznych i kauczuku syntetycznego w formach podstawowych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výroba základných chemikálií, priemyselných hnojív a dusíkatých zlúčenín (zmesí), plastov a syntetického kaučuku v primárnej forme</skos:altLabel>
	<skos:altLabel xml:lang="sl">Proizvodnja osnovnih kemikalij, gnojil in dušikovih spojin ter plastike in sintetičnega kavčuka v primarni obliki</skos:altLabel>
</rdf:Description>

