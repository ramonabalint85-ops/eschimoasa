<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/903">
	<skos:altLabel xml:lang="en">Support activities to arts creation and performing arts</skos:altLabel>
	<skos:altLabel xml:lang="fr">Activités de soutien à la création artistique et aux spectacles</skos:altLabel>
	<skos:altLabel xml:lang="bg">Спомагателни дейности, свързани с артистичната и творческата дейност и изпълнителското изкуство</skos:altLabel>
