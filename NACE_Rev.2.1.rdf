<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/U">
	<skos:prefLabel xml:lang="en">U ACTIVITIES OF HOUSEHOLDS AS EMPLOYERS AND UNDIFFERENTIATED GOODS - AND SERVICE-PRODUCING ACTIVITIES OF HOUSEHOLDS FOR OWN USE</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">U ACTIVITÉS DES MÉNAGES EN TANT QU’EMPLOYEURS; ACTIVITÉS INDIFFÉRENCIÉES DES MÉNAGES EN TANT QUE PRODUCTEURS DE BIENS ET SERVICES POUR USAGE PROPRE</skos:prefLabel>
	<skos:prefLabel xml:lang="bg">U ДЕЙНОСТИ НА ДОМАКИНСТВАТА КАТО РАБОТОДАТЕЛИ И НЕДИФЕРЕНЦИРАНИ ДЕЙНОСТИ НА ДОМАКИНСТВАТА ПО ПРОИЗВОДСТВО НА СТОКИ И УСЛУГИ ЗА СОБСТВЕНО ПОТРЕБЛЕНИЕ</skos:prefLabel>
	<skos:prefLabel xml:lang="cs">U ČINNOSTI DOMÁCNOSTÍ JAKO ZAMĚSTNAVATELŮ; ČINNOSTI DOMÁCNOSTÍ PRODUKUJÍCÍCH BLÍŽE NEURČENÉ VÝROBKY A SLUŽBY PRO VLASTNÍ POTŘEBU</skos:prefLabel>
	<skos:prefLabel xml:lang="da">U AKTIVITETER I HUSHOLDNINGER MED ANSAT MEDHJÆLP OG HUSHOLDNINGERS PRODUKTION AF UDIFFERENTIEREDE VARER OG TJENESTEYDELSER TIL EGET BRUG</skos:prefLabel>
	<skos:prefLabel xml:lang="el">U ΔΡΑΣΤΗΡΙΟΤΗΤΕΣ ΝΟΙΚΟΚΥΡΙΩΝ ΩΣ ΕΡΓΟΔΟΤΩΝ ΚΑΙ ΜΗ ΔΙΑΦΟΡΟΠΟΙΗΜΕΝΕΣ ΔΡΑΣΤΗΡΙΟΤΗΤΕΣ ΝΟΙΚΟΚΥΡΙΩΝ, ΠΟΥ ΑΦΟΡΟΥΝ ΤΗΝ ΠΑΡΑΓΩΓΗ ΑΓΑΘΩΝ –ΚΑΙ ΥΠΗΡΕΣΙΩΝ– ΓΙΑ ΙΔΙΑ ΧΡΗΣΗ</skos:prefLabel>
	<skos:prefLabel xml:lang="es">U ACTIVIDADES DE LOS HOGARES COMO EMPLEADORES Y COMO PRODUCTORES DE BIENES Y SERVICIOS NO DIFERENCIADOS PARA USO PROPIO</skos:prefLabel>
	<skos:prefLabel xml:lang="et">U KODUMAJAPIDAMISTE KUI TÖÖANDJATE TEGEVUS NING KODUMAJAPIDAMISTE OMA TARBEKS MÕELDUD ERISTAMATA KAUPADE TOOTMINE JA TEENUSTE OSUTAMINE</skos:prefLabel>
	<skos:prefLabel xml:lang="fi">U KOTITALOUKSIEN TOIMINTA TYÖNANTAJINA JA KOTITALOUKSIEN ERIYTTÄMÄTÖN TOIMINTA TAVAROIDEN JA PALVELUJEN TUOTTAMISEKSI OMAAN KÄYTTÖÖN</skos:prefLabel>
	<skos:prefLabel xml:lang="ga">U GNÍOMHAÍOCHTAÍ TEAGHLACH MAR FHOSTÓIRÍ AGUS GNÍOMHAÍOCHTAÍ TÁIRGTHE EARRAÍ NEAMHDHIFREÁILTE AGUS SEIRBHÍSÍ AG TEAGHLAIGH DÁ nÚSÁID FÉIN</skos:prefLabel>
	<skos:prefLabel xml:lang="hr">U DJELATNOSTI KUĆANSTAVA KAO POSLODAVACA I DJELATNOSTI KUĆANSTAVA KOJA PROIZVODE RAZLIČITU ROBU I OBAVLJAJU RAZLIČITE USLUGE ZA VLASTITE POTREBE</skos:prefLabel>
	<skos:prefLabel xml:lang="hu">U HÁZTARTÁS MUNKAADÓI TEVÉKENYSÉGE; TERMÉK ELŐÁLLÍTÁSA, SZOLGÁLTATÁS VÉGZÉSE SAJÁT FOGYASZTÁSRA</skos:prefLabel>
	<skos:prefLabel xml:lang="it">U ATTIVITÀ DI FAMIGLIE E CONVIVENZE COME DATORI DI LAVORO PER PERSONALE DOMESTICO E PRODUZIONE DI BENI E SERVIZI INDIFFERENZIATI PER USO PROPRIO DA PARTE DI FAMIGLIE E CONVIVENZE</skos:prefLabel>
	<skos:prefLabel xml:lang="lt">U NAMŲ ŪKIŲ, SAMDANČIŲ DARBININKUS, VEIKLA IR NAMŲ ŪKIŲ VEIKLA, SUSIJUSI SU SAVOMS REIKMĖMS TENKINTI SKIRTŲ NEDIFERENCIJUOJAMŲ GAMINIŲ GAMYBA IR PASLAUGŲ TEIKIMU</skos:prefLabel>
	<skos:prefLabel xml:lang="lv">U MĀJSAIMNIECĪBU KĀ DARBA DEVĒJU DARBĪBA UN MĀJSAMNIECĪBU VEIKTA NEDIFERENCĒTU PREČU RAŽOŠANA UN PAKALPOJUMU SNIEGŠANA PAŠU PATĒRIŅAM</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">U ATTIVITAJIET TAL-UNITAJIET DOMESTIĊI BĦALA IMPJEGATURI U ATTIVITAJIET TA’ PRODUZZJONI TA’ OĠĠETTI U SERVIZZI MHUX DIFFERENZJATI TAL-UNITAJIET DOMESTIĊI GĦALL-UŻU PROPRJU</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">U ACTIVITEITEN VAN HUISHOUDENS ALS WERKGEVER EN NIET-GEDIFFERENTIEERDE PRODUCTIE VAN GOEDEREN EN DIENSTEN DOOR HUISHOUDENS VOOR EIGEN GEBRUIK</skos:prefLabel>
	<skos:prefLabel xml:lang="pt">U ATIVIDADES DAS FAMÍLIAS EMPREGADORAS DE PESSOAL DOMÉSTICO E ATIVIDADES DE PRODUÇÃO DE BENS E SERVIÇOS PELAS FAMÍLIAS PARA USO PRÓPRIO</skos:prefLabel>
	<skos:prefLabel xml:lang="ro">U ACTIVITĂȚI ALE GOSPODĂRIILOR PRIVATE ÎN CALITATE DE ANGAJATORI; ACTIVITĂȚI ALE GOSPODĂRIILOR PRIVATE DE PRODUCERE DE BUNURI ȘI SERVICII PENTRU UZ PROPRIU</skos:prefLabel>
	<skos:prefLabel xml:lang="sv">U FÖRVÄRVSARBETE I HUSHÅLL OCH HUSHÅLLENS PRODUKTION AV DIVERSE VAROR OCH TJÄNSTER FÖR EGET BRUK</skos:prefLabel>
	<skos:prefLabel xml:lang="de">U PRIVATE HAUSHALTE MIT HAUSPERSONAL SOWIE HERSTELLUNG VON WAREN UND ERBRINGUNG VON DIENSTLEISTUNGEN DURCH PRIVATE HAUSHALTE FÜR DEN EIGENBEDARF OHNE AUSGEPRÄGTEN SCHWERPUNKT</skos:prefLabel>
	<skos:prefLabel xml:lang="pl">U GOSPODARSTWA DOMOWE ZATRUDNIAJĄCE PRACOWNIKÓW ORAZ GOSPODARSTWA DOMOWE PRODUKUJĄCE WYROBY I ŚWIADCZĄCE USŁUGI NA WŁASNE POTRZEBY</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">U ČINNOSTI DOMÁCNOSTÍ AKO ZAMESTNÁVATEĽOV; NEDIFERENCOVANÉ ČINNOSTI V DOMÁCNOSTIACH PRODUKUJÚCE TOVAR NA VLASTNÉ POUŽITIE</skos:prefLabel>
	<skos:prefLabel xml:lang="sl">U DEJAVNOST GOSPODINJSTEV Z ZAPOSLENIM HIŠNIM OSEBJEM TER PROIZVODNJA ZA LASTNO RABO</skos:prefLabel>
</rdf:Description>

