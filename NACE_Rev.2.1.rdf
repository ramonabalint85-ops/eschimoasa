	<skos:altLabel xml:lang="ga">Monarú aerárthaí agus spásárthaí agus innealra ghaolmhair</skos:altLabel>
	<skos:altLabel xml:lang="hr">Proizvodnja zrakoplova i svemirskih letjelica te srodnih strojeva i opreme</skos:altLabel>
	<skos:altLabel xml:lang="hu">Légi, űrjármű gyártása</skos:altLabel>
	<skos:altLabel xml:lang="it">Fabbricazione di aeromobili, veicoli spaziali e relativi equipaggiamenti</skos:altLabel>
	<skos:altLabel xml:lang="lt">Orlaivių ir erdvėlaivių bei susijusios įrangos gamyba</skos:altLabel>
	<skos:altLabel xml:lang="lv">Gaisa kuģu un kosmisko aparātu un ar tiem saistītu iekārtu ražošana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Manifattura tal-inġenji tal-ajru u tal-ispazju u l-makkinarju relatat</skos:altLabel>
	<skos:altLabel xml:lang="nl">Vervaardiging van lucht- en ruimtevaartuigen en van toestellen in verband daarmee</skos:altLabel>
	<skos:altLabel xml:lang="pt">Fabricação de aeronaves, veículos espaciais e equipamento relacionado</skos:altLabel>
	<skos:altLabel xml:lang="ro">Fabricarea aeronavelor, navelor spațiale și a mașinilor asociate</skos:altLabel>
	<skos:altLabel xml:lang="sl">Proizvodnja zračnih in vesoljskih plovil</skos:altLabel>
	<skos:altLabel xml:lang="sv">Tillverkning av luftfartyg, rymdfarkoster o.d.</skos:altLabel>
	<skos:altLabel xml:lang="de">Luft- und Raumfahrzeugbau</skos:altLabel>
	<skos:altLabel xml:lang="pl">Produkcja statków powietrznych, statków kosmicznych i podobnych maszyn</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výroba lietadiel a kozmických lodí a podobných zariadení</skos:altLabel>
</rdf:Description>

