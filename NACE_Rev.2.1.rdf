	<skos:prefLabel xml:lang="fi">95.3 Moottoriajoneuvojen ja moottoripyörien korjaus ja huolto</skos:prefLabel>
	<skos:prefLabel xml:lang="ga">95.3 Deisiú agus cothabháil mótarfheithiclí agus gluaisrothar</skos:prefLabel>
	<skos:prefLabel xml:lang="hr">95.3 Popravak i održavanje motornih vozila i motocikala</skos:prefLabel>
	<skos:prefLabel xml:lang="hu">95.3 Gépjármű, motorkerékpár javítása, karbantartása</skos:prefLabel>
	<skos:prefLabel xml:lang="it">95.3 Riparazione e manutenzione di autoveicoli e motocicli</skos:prefLabel>
	<skos:prefLabel xml:lang="lt">95.3 Variklinių transporto priemonių ir motociklų remontas ir techninė priežiūra</skos:prefLabel>
	<skos:prefLabel xml:lang="lv">95.3 Mehānisko transportlīdzekļu un motociklu remonts un apkope</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">95.3 Tiswija u manutenzjoni tal-vetturi motorizzati u l-muturi</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">95.3 Reparatie en onderhoud van motorvoertuigen en motorfietsen</skos:prefLabel>
	<skos:prefLabel xml:lang="pt">95.3 Reparação e manutenção de veículos automóveis e motociclos</skos:prefLabel>
	<skos:prefLabel xml:lang="ro">95.3 Repararea și întreținerea autovehiculelor și a motocicletelor</skos:prefLabel>
	<skos:prefLabel xml:lang="sl">95.3 Popravila in vzdrževanje motornih vozil in motornih koles</skos:prefLabel>
	<skos:prefLabel xml:lang="sv">95.3 Reparation och underhåll av motorfordon och motorcyklar</skos:prefLabel>
	<skos:prefLabel xml:lang="de">95.3 Reparatur und Instandhaltung von Kraftwagen und Krafträdern</skos:prefLabel>
	<skos:prefLabel xml:lang="pl">95.3 Naprawa i konserwacja pojazdów silnikowych, w tym motocykli</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">95.3 Oprava a údržba motorových vozidiel a motocyklov</skos:prefLabel>
</rdf:Description>

