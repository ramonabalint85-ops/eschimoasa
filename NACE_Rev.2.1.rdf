<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/853">
	<skos:altLabel xml:lang="en">Secondary and post-secondary non-tertiary education</skos:altLabel>
	<skos:altLabel xml:lang="fr">Enseignement secondaire et enseignement post-secondaire non supérieur</skos:altLabel>
	<skos:altLabel xml:lang="bg">Прогимназиално (втори етап на основното образование) и средно образование и професионално обучение след средно образование, но не висше</skos:altLabel>
	<skos:altLabel xml:lang="cs">Sekundární a postsekundární neterciární vzdělávání</skos:altLabel>
	<skos:altLabel xml:lang="da">Undervisning på gymnasier og erhvervsfaglige skoler samt videregående uddannelse, ikke på universitetsniveau</skos:altLabel>
	<skos:altLabel xml:lang="el">Δευτεροβάθμια και μεταδευτεροβάθμια μη τριτοβάθμια εκπαίδευση</skos:altLabel>
	<skos:altLabel xml:lang="es">Educación secundaria y educación postsecundaria no terciaria</skos:altLabel>
	<skos:altLabel xml:lang="et">Põhihariduse III kooliaste, üldkeskharidus ja kutseharidus</skos:altLabel>
	<skos:altLabel xml:lang="fi">Ylemmän perusasteen, toisen asteen ja erikoisammattikoulutus</skos:altLabel>
	<skos:altLabel xml:lang="ga">Meánoideachas agus oideachas iar-mheánscoile neamhthreasach</skos:altLabel>
	<skos:altLabel xml:lang="hr">Srednjoškolsko obrazovanje i obrazovanje nakon srednjoškolskog koje nije visoko</skos:altLabel>
	<skos:altLabel xml:lang="hu">Középfokú oktatás és középfok utáni nem felsőfokú oktatás</skos:altLabel>
	<skos:altLabel xml:lang="it">Istruzione secondaria e post-secondaria non terziaria</skos:altLabel>
	<skos:altLabel xml:lang="lt">Pagrindinis ir vidurinis ugdymas, aukštojo mokslo laipsnio nesuteikiantis mokymas turint vidurinį išsilavinimą</skos:altLabel>
	<skos:altLabel xml:lang="lv">Vidējā izglītība un pēcvidējā izglītība, kas nav augstākā izglītība</skos:altLabel>
	<skos:altLabel xml:lang="mt">Edukazzjoni sekondarja u postsekondarja nonterzjarja</skos:altLabel>
	<skos:altLabel xml:lang="nl">Secundair en postsecundair niet-tertiair onderwijs</skos:altLabel>
	<skos:altLabel xml:lang="pt">Ensino básico (3.° ciclo) e secundário e pós-secundário não superior</skos:altLabel>
	<skos:altLabel xml:lang="ro">Învățământ liceal și învățământ postliceal neuniversitar</skos:altLabel>
	<skos:altLabel xml:lang="sl">Sekundarno in posekundarno neterciarno izobraževanje</skos:altLabel>
	<skos:altLabel xml:lang="sv">Gymnasial och eftergymnasial utbildning vid annat än universitet eller högskola</skos:altLabel>
	<skos:altLabel xml:lang="de">Weiterführende Schulen und postsekundärer, nicht tertiärer Unterricht</skos:altLabel>
	<skos:altLabel xml:lang="pl">Szkoły ponadpodstawowe i placówki kształcenia policealnego</skos:altLabel>
	<skos:altLabel xml:lang="sk">Stredné školstvo a pomaturitné neterciárne vzdelávanie</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/8531">
	<skos:altLabel xml:lang="en">General secondary education</skos:altLabel>
	<skos:altLabel xml:lang="fr">Enseignement secondaire general</skos:altLabel>
	<skos:altLabel xml:lang="bg">Прогимназиално и средно общо образование</skos:altLabel>
	<skos:altLabel xml:lang="cs">Sekundární všeobecné vzdělávání</skos:altLabel>
	<skos:altLabel xml:lang="da">Undervisning på gymnasier, studenterkurser o.l.</skos:altLabel>
	<skos:altLabel xml:lang="el">Γενική δευτεροβάθμια εκπαίδευση</skos:altLabel>
	<skos:altLabel xml:lang="es">Educación secundaria general</skos:altLabel>
	<skos:altLabel xml:lang="et">Põhihariduse III kooliaste ja üldkeskharidus</skos:altLabel>
	<skos:altLabel xml:lang="fi">Ylemmän perusasteen koulutus ja lukiokoulutus</skos:altLabel>
	<skos:altLabel xml:lang="ga">Meánoideachas ginearálta</skos:altLabel>
	<skos:altLabel xml:lang="hr">Opće srednjoškolsko obrazovanje</skos:altLabel>
	<skos:altLabel xml:lang="hu">Általános középfokú oktatás</skos:altLabel>
	<skos:altLabel xml:lang="it">Istruzione secondaria di formazione generale</skos:altLabel>
	<skos:altLabel xml:lang="lt">Bendrasis pagrindinis ir vidurinis ugdymas</skos:altLabel>
	<skos:altLabel xml:lang="lv">Vispārējā vidējā izglītība</skos:altLabel>
	<skos:altLabel xml:lang="mt">Edukazzjoni sekondarja ġenerali</skos:altLabel>
	<skos:altLabel xml:lang="nl">Algemeen vormend voortgezet onderwijs</skos:altLabel>
	<skos:altLabel xml:lang="pl">Szkoły średnie ogólnokształcące</skos:altLabel>
	<skos:altLabel xml:lang="pt">Ensino básico (3.° ciclo) e secundário geral</skos:altLabel>
	<skos:altLabel xml:lang="ro">Învățământ liceal general</skos:altLabel>
	<skos:altLabel xml:lang="sl">Splošno sekundarno izobraževanje</skos:altLabel>
	<skos:altLabel xml:lang="sk">Stredné všeobecno-vzdelávacie školstvo</skos:altLabel>
	<skos:altLabel xml:lang="sv">Studieförberedande gymnasial utbildning</skos:altLabel>
	<skos:altLabel xml:lang="de">Allgemeinbildende weiterführende Schulen</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/8532">
	<skos:altLabel xml:lang="en">Vocational secondary education</skos:altLabel>
	<skos:altLabel xml:lang="fr">Enseignement secondaire professionnel</skos:altLabel>
	<skos:altLabel xml:lang="bg">Прогимназиално и средно професионално образование и обучение</skos:altLabel>
