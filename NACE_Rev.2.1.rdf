<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/749">
	<skos:altLabel xml:lang="en">Other professional, scientific and technical activities n.e.c.</skos:altLabel>
	<skos:altLabel xml:lang="fr">Autres activités spécialisées, scientifiques et techniques n.c.a.</skos:altLabel>
	<skos:altLabel xml:lang="bg">Други професионални дейности, некласифицирани другаде</skos:altLabel>
	<skos:altLabel xml:lang="cs">Ostatní odborné, vědecké a technické činnosti j. n.</skos:altLabel>
	<skos:altLabel xml:lang="da">Andre liberale, videnskabelige og tekniske aktiviteter i.a.n.</skos:altLabel>
	<skos:altLabel xml:lang="el">Άλλες επαγγελματικές, επιστημονικές και τεχνικές δραστηριότητες π.δ.κ.α.</skos:altLabel>
	<skos:altLabel xml:lang="es">Otras actividades profesionales, científicas y técnicas n.c.o.p.</skos:altLabel>
	<skos:altLabel xml:lang="et">Muu mujal liigitamata kutse-, teadus- ja tehnikaalane tegevus</skos:altLabel>
	<skos:altLabel xml:lang="fi">Muualla luokittelematon muu ammatillinen, tieteellinen ja tekninen toiminta</skos:altLabel>
	<skos:altLabel xml:lang="ga">Gníomhaíochtaí eile gairmiúla, eolaíocha agus teicniúla nach n-aicmítear in áit ar bith eile</skos:altLabel>
	<skos:altLabel xml:lang="hr">Ostale stručne, znanstvene i tehničke djelatnosti, d. n.</skos:altLabel>
	<skos:altLabel xml:lang="hu">M.n.s. egyéb szakmai, tudományos, műszaki tevékenység</skos:altLabel>
	<skos:altLabel xml:lang="it">Altre attività professionali, scientifiche e tecniche n.c.a.</skos:altLabel>
	<skos:altLabel xml:lang="lt">Kita, niekur kitur nepriskirta, profesinė, mokslinė ir techninė veikla</skos:altLabel>
	<skos:altLabel xml:lang="lv">Citur neklasificēti profesionālie, zinātniskie un tehniskie pakalpojumi</skos:altLabel>
	<skos:altLabel xml:lang="mt">Attivitajiet professjonali, xjentifiċi u tekniċi oħra m.k.b.</skos:altLabel>
	<skos:altLabel xml:lang="nl">Overige wetenschappelijke en technische activiteiten en overige specialistische zakelijke dienstverlening, n.e.g.</skos:altLabel>
	<skos:altLabel xml:lang="pt">Outras atividades de consultoria, científicas, técnicas e similares, n.e.</skos:altLabel>
	<skos:altLabel xml:lang="ro">Alte activități profesionale, științifice și tehnice n.c.a.</skos:altLabel>
	<skos:altLabel xml:lang="sl">Druge strokovne, znanstvene in tehnične dejavnosti, d. n.</skos:altLabel>
	<skos:altLabel xml:lang="sv">Diverse övrig verksamhet inom juridik, ekonomi, vetenskap och teknik</skos:altLabel>
	<skos:altLabel xml:lang="de">Sonstige wissenschaftliche und technische Tätigkeiten a. n. g.</skos:altLabel>
	<skos:altLabel xml:lang="pl">Pozostała działalność profesjonalna, naukowa i techniczna, gdzie indziej niesklasyfikowana</skos:altLabel>
	<skos:altLabel xml:lang="sk">Ostatné odborné, vedecké a technické činnosti i. n.</skos:altLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/7491">
	<skos:altLabel xml:lang="en">Patent brokering and marketing service activities</skos:altLabel>
	<skos:altLabel xml:lang="fr">Activités de courtage et de marketing de brevets</skos:altLabel>
	<skos:altLabel xml:lang="bg">Брокерска дейност в областта на патентите и маркетингови дейности</skos:altLabel>
	<skos:altLabel xml:lang="cs">Činnosti patentových zástupců a prodej patentů</skos:altLabel>
	<skos:altLabel xml:lang="da">Patentbureauers aktiviteter og tjenesteydelser i forbindelse med markedsføring</skos:altLabel>
	<skos:altLabel xml:lang="el">Δραστηριότητες διαμεσολάβησης σε θέματα διπλωμάτων ευρεσιτεχνίας και παροχής υπηρεσιών μάρκετινγκ</skos:altLabel>
	<skos:altLabel xml:lang="es">Actividades de los agentes de patentes y de los servicios de comercialización</skos:altLabel>
	<skos:altLabel xml:lang="et">Patentide vahendamine ja turundus</skos:altLabel>
	<skos:altLabel xml:lang="fi">Patenttien välitys- ja markkinointipalvelut</skos:altLabel>
	<skos:altLabel xml:lang="ga">Bróicéireacht paitinní agus gníomhaíochtaí seirbhíse margaíochta</skos:altLabel>
	<skos:altLabel xml:lang="hr">Uslužne djelatnosti posredovanja i promidžbe u vezi s patentima</skos:altLabel>
	<skos:altLabel xml:lang="hu">Szabadalmi ügynöki tevékenység, marketingszolgáltatás</skos:altLabel>
	<skos:altLabel xml:lang="it">Attività di servizi di intermediazione e marketing di brevetti</skos:altLabel>
	<skos:altLabel xml:lang="lt">Tarpininkavimo išduodant patentus ir rinkodaros paslaugų veikla</skos:altLabel>
	<skos:altLabel xml:lang="lv">Patentu starpniecības un tirgvedības pakalpojumi</skos:altLabel>
	<skos:altLabel xml:lang="mt">Attivitajiet ta’ servizzi ta’ senserija tal-privattivi u tal-kummerċjalizzazzjoni</skos:altLabel>
	<skos:altLabel xml:lang="nl">Bemiddeling in en het in de handel brengen van octrooien</skos:altLabel>
	<skos:altLabel xml:lang="pt">Atividades de serviços de comercialização e corretagem de patentes</skos:altLabel>
	<skos:altLabel xml:lang="ro">Activități de brokeraj în materie de brevete și servicii de marketing</skos:altLabel>
	<skos:altLabel xml:lang="sl">Storitve patentnega posredništva in trženja</skos:altLabel>
	<skos:altLabel xml:lang="sv">Patentförmedling samt marknadsföring av patent</skos:altLabel>
	<skos:altLabel xml:lang="de">Erbringung von Vermittlungs- und Vermarktungsdienstleistungen für Patente</skos:altLabel>
	<skos:altLabel xml:lang="pl">Pośrednictwo w obrocie patentami i działalność marketingowa w tym zakresie</skos:altLabel>
	<skos:altLabel xml:lang="sk">Sprostredkovanie patentov a marketingové činnosti</skos:altLabel>
</rdf:Description>

