<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/721">
	<skos:altLabel xml:lang="en">Research and experimental development on natural sciences and engineering</skos:altLabel>
	<skos:altLabel xml:lang="fr">Recherche et développement en sciences physiques et naturelles</skos:altLabel>
	<skos:altLabel xml:lang="bg">Научноизследователска и развойна дейност в областта на естествените, медицинските, селскостопанските и техническите науки</skos:altLabel>
	<skos:altLabel xml:lang="cs">Výzkum a vývoj v oblasti přírodních a technických věd</skos:altLabel>
	<skos:altLabel xml:lang="da">Forskning og eksperimentel udvikling inden for naturvidenskab og teknik</skos:altLabel>
	<skos:altLabel xml:lang="el">Έρευνα και πειραματική ανάπτυξη στις φυσικές επιστήμες και τη μηχανική</skos:altLabel>
	<skos:altLabel xml:lang="es">Investigación y desarrollo experimental en ciencias naturales y técnicas</skos:altLabel>
	<skos:altLabel xml:lang="et">Teadus- ja arendustegevus loodus- ja tehnikateaduste vallas</skos:altLabel>
	<skos:altLabel xml:lang="fi">Luonnontieteen ja tekniikan tutkimus ja kehittäminen</skos:altLabel>
	<skos:altLabel xml:lang="ga">Taighde agus forbairt thrialach ar eolaíochtaí aiceanta agus innealtóireacht</skos:altLabel>
	<skos:altLabel xml:lang="hr">Istraživanje i eksperimentalni razvoj u prirodnim, tehničkim i tehnološkim znanostima</skos:altLabel>
	<skos:altLabel xml:lang="hu">Természettudományi, műszaki kutatás, kísérleti fejlesztés</skos:altLabel>
	<skos:altLabel xml:lang="it">Ricerca e sviluppo sperimentale nel campo delle scienze naturali e dell’ingegneria</skos:altLabel>
	<skos:altLabel xml:lang="lt">Gamtos mokslų ir inžinerijos moksliniai tyrimai ir taikomoji veikla</skos:altLabel>
	<skos:altLabel xml:lang="lv">Pētniecība un eksperimentālā izstrāde dabaszinātnēs un inženierzinātnēs</skos:altLabel>
	<skos:altLabel xml:lang="mt">Riċerka u żvilupp esperimentali dwar ix-xjenzi naturali u l-inġinerija</skos:altLabel>
	<skos:altLabel xml:lang="nl">Speur- en ontwikkelingswerk op natuurwetenschappelijk gebied</skos:altLabel>
	<skos:altLabel xml:lang="pt">Investigação e desenvolvimento das ciências físicas e naturais</skos:altLabel>
	<skos:altLabel xml:lang="ro">Cercetare-dezvoltare în științe naturale și inginerie</skos:altLabel>
	<skos:altLabel xml:lang="sl">Raziskovalna in razvojna dejavnost na področju naravoslovja in tehnologije</skos:altLabel>
	<skos:altLabel xml:lang="sv">Naturvetenskaplig och teknisk forskning och utveckling</skos:altLabel>
	<skos:altLabel xml:lang="de">Forschung und Entwicklung im Bereich Natur-, Ingenieur-, Agrarwissenschaften und Medizin</skos:altLabel>
	<skos:altLabel xml:lang="pl">Badania naukowe i prace rozwojowe w dziedzinie nauk przyrodniczych i technicznych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Výskum a experimentálny vývoj v oblasti prírodných a technických vied</skos:altLabel>
</rdf:Description>

