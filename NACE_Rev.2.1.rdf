<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/1621">
	<skos:prefLabel xml:lang="en">16.21 Manufacture of veneer sheets and wood-based panels</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">16.21 Fabrication de placage et de panneaux de bois</skos:prefLabel>
	<skos:prefLabel xml:lang="bg">16.21 Производство на фурнир и дървесни плочи</skos:prefLabel>
