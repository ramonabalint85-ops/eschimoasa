<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/243">
	<skos:altLabel xml:lang="en">Manufacture of other products of first processing of steel</skos:altLabel>
	<skos:altLabel xml:lang="fr">Fabrication d’autres produits de première transformation de l’acier</skos:altLabel>
	<skos:altLabel xml:lang="bg">Производство на други продукти при първичната преработка на стомана</skos:altLabel>
	<skos:altLabel xml:lang="cs">Výroba ostatních výrobků získaných primárním zpracováním oceli</skos:altLabel>
	<skos:altLabel xml:lang="da">Fremstilling af andre produkter af den primære forarbejdning af stål</skos:altLabel>
	<skos:altLabel xml:lang="el">Κατασκευή άλλων προϊόντων πρωτογενούς επεξεργασίας χάλυβα</skos:altLabel>
	<skos:altLabel xml:lang="es">Fabricación de otros productos de primera transformación del acero</skos:altLabel>
	<skos:altLabel xml:lang="et">Muude terase esmatöötlustoodete tootmine</skos:altLabel>
	<skos:altLabel xml:lang="fi">Muu teräksen jalostus</skos:altLabel>
	<skos:altLabel xml:lang="ga">Monarú táirgí eile de chéad phróiseáil na cruach</skos:altLabel>
