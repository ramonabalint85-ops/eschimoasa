	<skos:altLabel xml:lang="cs">Činnosti domácností jako zaměstnavatelů domácího personálu</skos:altLabel>
	<skos:altLabel xml:lang="da">Aktiviteter i husholdninger med ansat medhjælp</skos:altLabel>
	<skos:altLabel xml:lang="el">Δραστηριότητες νοικοκυριών ως εργοδοτών οικιακού προσωπικού</skos:altLabel>
	<skos:altLabel xml:lang="es">Actividades de los hogares como empleadores de personal doméstico</skos:altLabel>
