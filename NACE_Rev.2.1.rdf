<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/7499">
	<skos:prefLabel xml:lang="en">74.99 All other professional, scientific and technical activities n.e.c.</skos:prefLabel>
	<skos:prefLabel xml:lang="hu">74.99 M.n.s. egyéb szakmai, tudományos, műszaki tevékenység</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">74.99 Toutes les autres activités spécialisées, scientifiques et techniques n.c.a.</skos:prefLabel>
	<skos:prefLabel xml:lang="bg">74.99 Останалите други професионални дейности, некласифицирани другаде</skos:prefLabel>
	<skos:prefLabel xml:lang="cs">74.99 Všechny ostatní odborné, vědecké a technické činnosti j. n.</skos:prefLabel>
	<skos:prefLabel xml:lang="da">74.99 Alle andre liberale, videnskabelige og tekniske aktiviteter i.a.n.</skos:prefLabel>
	<skos:prefLabel xml:lang="el">74.99 Όλες οι άλλες επαγγελματικές, επιστημονικές και τεχνικές δραστηριότητες π.δ.κ.α.</skos:prefLabel>
	<skos:prefLabel xml:lang="es">74.99 Todas las demás actividades profesionales, científicas y técnicas n.c.o.p.</skos:prefLabel>
	<skos:prefLabel xml:lang="et">74.99 Kogu muu mujal liigitamata kutse-, teadus- ja tehnikaalane tegevus</skos:prefLabel>
	<skos:prefLabel xml:lang="fi">74.99 Muualla luokittelematon kaikki muu ammatillinen, tieteellinen ja tekninen toiminta</skos:prefLabel>
	<skos:prefLabel xml:lang="ga">74.99 Gach gníomhaíocht ghairmiúil, eolaíoch agus theicniúil eile nach n-aicmítear in áit ar bith eile</skos:prefLabel>
	<skos:prefLabel xml:lang="hr">74.99 Sve ostale stručne, znanstvene i tehničke djelatnosti, d. n.</skos:prefLabel>
	<skos:prefLabel xml:lang="it">74.99 Tutte le altre attività professionali, scientifiche e tecniche n.c.a.</skos:prefLabel>
	<skos:prefLabel xml:lang="lt">74.99 Visa kita, niekur kitur nepriskirta, profesinė, mokslinė ir techninė veikla</skos:prefLabel>
	<skos:prefLabel xml:lang="lv">74.99 Citur neklasificēti pārējie profesionālie, zinātniskie un tehniskie pakalpojumi</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">74.99 Kull attività professjonali, xjentifika u teknika oħra m.k.b.</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">74.99 Alle overige wetenschappelijke en technische activiteiten en overige specialistische zakelijke dienstverlening, n.e.g.</skos:prefLabel>
	<skos:prefLabel xml:lang="pt">74.99 Todas as outras atividades de consultoria, científicas, técnicas e similares, n.e.</skos:prefLabel>
	<skos:prefLabel xml:lang="ro">74.99 Toate celelalte activități profesionale, științifice și tehnice n.c.a.</skos:prefLabel>
	<skos:prefLabel xml:lang="sl">74.99 Vse druge strokovne, znanstvene in tehnične dejavnosti, d. n.</skos:prefLabel>
	<skos:prefLabel xml:lang="sv">74.99 All övrig verksamhet inom juridik, ekonomi, vetenskap och teknik</skos:prefLabel>
	<skos:prefLabel xml:lang="de">74.99 Alle anderen wissenschaftlichen und technischen Tätigkeiten a. n. g.</skos:prefLabel>
	<skos:prefLabel xml:lang="pl">74.99 Wszelka pozostała działalność profesjonalna, naukowa i techniczna gdzie indziej niesklasyfikowana</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">74.99 Všetky ostatné odborné, vedecké a technické činnosti i. n.</skos:prefLabel>
</rdf:Description>

