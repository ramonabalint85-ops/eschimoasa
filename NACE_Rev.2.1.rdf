<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/E">
	<skos:prefLabel xml:lang="en">E WATER SUPPLY; SEWERAGE, WASTE MANAGEMENT AND REMEDIATION ACTIVITIES</skos:prefLabel>
