<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/7733">
	<skos:altLabel xml:lang="en">Rental and leasing of office machinery, equipment and computers</skos:altLabel>
	<skos:altLabel xml:lang="fr">Location et location-bail de machines et équipements de bureau et d’ordinateurs</skos:altLabel>
