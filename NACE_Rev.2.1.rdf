<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/35">
	<skos:altLabel xml:lang="en">Electricity, gas, steam and air conditioning supply</skos:altLabel>
	<skos:altLabel xml:lang="fr">Production et distribution d’électricité, de gaz, de vapeur et d’air conditionné</skos:altLabel>
