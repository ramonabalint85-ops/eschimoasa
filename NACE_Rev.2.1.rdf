	<skos:prefLabel xml:lang="sl">46.1 Trgovina na debelo za plačilo ali po pogodbi</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">46.1 Sprostredkovanie veľkoobchodu</skos:prefLabel>
	<skos:prefLabel xml:lang="sv">46.1 Provisionshandel</skos:prefLabel>
	<skos:prefLabel xml:lang="de">46.1 Handelsvermittlung</skos:prefLabel>
