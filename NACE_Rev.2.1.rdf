	<skos:prefLabel xml:lang="pt">82.4 Atividades de serviços de intermediação de atividades de serviços de apoio aos negócios, n.e.</skos:prefLabel>
	<skos:prefLabel xml:lang="ro">82.4 Activități de servicii de intermediere pentru activități suport pentru întreprinderi n.c.a.</skos:prefLabel>
	<skos:prefLabel xml:lang="sl">82.4 Posredniške storitve za spremljajoče poslovne storitvene dejavnosti, d. n.</skos:prefLabel>
	<skos:prefLabel xml:lang="sv">82.4 Förmedling avseende övrig stödverksamhet till företag</skos:prefLabel>
	<skos:prefLabel xml:lang="de">82.4 Vermittlungstätigkeiten für die Erbringung von wirtschaftlichen Dienstleistungen für Unternehmen und Privatpersonen a. n. g.</skos:prefLabel>
	<skos:prefLabel xml:lang="pl">82.4 Pośrednictwo w zakresie działalności wspomagającej prowadzenie działalności gospodarczej, gdzie indziej niesklasyfikowane</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">82.4 Sprostredkovateľské služby v pomocných obchodných činnostiach i. n.</skos:prefLabel>
</rdf:Description>

