	<skos:altLabel xml:lang="da">Engroshandel med landbrugsråvarer og levende dyr</skos:altLabel>
	<skos:altLabel xml:lang="el">Χονδρικό εμπόριο ακατέργαστων γεωργικών πρώτων υλών και ζώντων ζώων</skos:altLabel>
