<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/0113">
	<skos:altLabel xml:lang="en">Growing of vegetables and melons, roots and tubers</skos:altLabel>
	<skos:altLabel xml:lang="fr">Culture de légumes, de melons, de racines et de tubercules</skos:altLabel>
	<skos:altLabel xml:lang="bg">Отглеждане на зеленчуци, дини и пъпеши, кореноплодни и грудкови</skos:altLabel>
	<skos:altLabel xml:lang="cs">Pěstování zeleniny a melounů, kořenů a hlíz</skos:altLabel>
	<skos:altLabel xml:lang="da">Dyrkning af grøntsager og meloner, rødder og rodknolde</skos:altLabel>
	<skos:altLabel xml:lang="el">Καλλιέργεια λαχανικών και πεπονοειδών, ριζών και κονδύλων</skos:altLabel>
	<skos:altLabel xml:lang="es">Cultivo de hortalizas, raíces y tubérculos</skos:altLabel>
	<skos:altLabel xml:lang="et">Köögivilja- ja melonikasvatus, juurvilja- ja mugulviljakasvatus</skos:altLabel>
	<skos:altLabel xml:lang="fi">Vihannesten ja melonien, juuresten ja mukulakasvien viljely</skos:altLabel>
	<skos:altLabel xml:lang="ga">Saothrú glasraí agus mealbhacán, fréamhacha agus tiúbar</skos:altLabel>
	<skos:altLabel xml:lang="hr">Uzgoj povrća, dinja i lubenica, korjenastog i gomoljastog povrća</skos:altLabel>
	<skos:altLabel xml:lang="hu">Zöldségféle, dinnye, gyökér-, gumósnövény termesztése</skos:altLabel>
	<skos:altLabel xml:lang="it">Coltivazione di ortaggi e meloni, radici e tuberi</skos:altLabel>
	<skos:altLabel xml:lang="lt">Daržovių ir melionų, šakniavaisių ir gumbavaisių auginimas</skos:altLabel>
	<skos:altLabel xml:lang="lv">Dārzeņu un meloņu, sakņu un bumbuļaugu audzēšana</skos:altLabel>
	<skos:altLabel xml:lang="mt">Tkabbir tal-ħaxix u tal-bettieħ, l-għeruq u t-tuberi</skos:altLabel>
	<skos:altLabel xml:lang="nl">Teelt van groenten, meloenen en wortel- en knolgewassen</skos:altLabel>
	<skos:altLabel xml:lang="pt">Cultura de produtos hortícolas e melões, raízes e tubérculos</skos:altLabel>
	<skos:altLabel xml:lang="ro">Cultivarea legumelor și a pepenilor, a rădăcinoaselor și a tuberculilor</skos:altLabel>
	<skos:altLabel xml:lang="sl">Pridelovanje zelenjadnic in melon, korenovk in gomoljnic</skos:altLabel>
	<skos:altLabel xml:lang="sv">Odling av grönsaker och meloner, rotfrukter och stam- eller rotknölar</skos:altLabel>
	<skos:altLabel xml:lang="de">Anbau von Gemüse und Melonen sowie Wurzeln und Knollen</skos:altLabel>
	<skos:altLabel xml:lang="pl">Uprawa warzyw, włączając melony, oraz uprawa roślin korzeniowych i roślin bulwiastych</skos:altLabel>
	<skos:altLabel xml:lang="sk">Pestovanie zeleniny a melónov, koreňovej a hľuzovej zeleniny</skos:altLabel>
</rdf:Description>

