<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/9529">
	<skos:prefLabel xml:lang="en">95.29 Repair and maintenance of personal and household goods n.e.c.</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">95.29 Réparation et entretien d’autres biens personnels ou domestiques n.c.a.</skos:prefLabel>
	<skos:prefLabel xml:lang="bg">95.29 Ремонт и поддържане на лични и домакински вещи, некласифицирани другаде</skos:prefLabel>
	<skos:prefLabel xml:lang="cs">95.29 Opravy a údržba výrobků pro osobní potřebu a převážně pro domácnost j. n.</skos:prefLabel>
	<skos:prefLabel xml:lang="da">95.29 Reparation og vedligeholdelse af varer til personlig brug og husholdningsbrug i.a.n.</skos:prefLabel>
	<skos:prefLabel xml:lang="el">95.29 Επισκευή και συντήρηση ειδών προσωπικής και οικιακής χρήσης π.δ.κ.α.</skos:prefLabel>
	<skos:prefLabel xml:lang="es">95.29 Reparación y mantenimiento de efectos personales y artículos de uso doméstico n.c.o.p.</skos:prefLabel>
	<skos:prefLabel xml:lang="et">95.29 Mujal liigitamata tarbeesemete ja kodutarvete parandus ja hooldus</skos:prefLabel>
	<skos:prefLabel xml:lang="fi">95.29 Muualla luokittelematon henkilökohtaisten ja taloustavaroiden korjaus ja huolto</skos:prefLabel>
	<skos:prefLabel xml:lang="ga">95.29 Deisiú agus cothabháil earraí pearsanta agus tí nach n-aicmítear in áit ar bith eile</skos:prefLabel>
	<skos:prefLabel xml:lang="hr">95.29 Popravak i održavanje predmeta za osobnu uporabu i kućanstvo, d.n.</skos:prefLabel>
	<skos:prefLabel xml:lang="hu">95.29 M.n.s. személyi, háztartási cikk javítása, karbantartása</skos:prefLabel>
	<skos:prefLabel xml:lang="it">95.29 Riparazione e manutenzione di beni per uso personale e per la casa n.c.a.</skos:prefLabel>
	<skos:prefLabel xml:lang="lt">95.29 Niekur kitur nepriskirtų asmeninių ir namų ūkio reikmenų taisymas ir priežiūra</skos:prefLabel>
	<skos:prefLabel xml:lang="lv">95.29 Citur neklasificētu personīgas lietošanas un mājsaimniecības preču remonts un apkope</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">95.29 Tiswija u manutenzjoni tal-oġġetti personali u domestiċi m.k.b.</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">95.29 Reparatie en onderhoud van consumentenartikelen, n.e.g.</skos:prefLabel>
	<skos:prefLabel xml:lang="pt">95.29 Reparação e manutenção de bens de uso pessoal e doméstico, n.e.</skos:prefLabel>
	<skos:prefLabel xml:lang="ro">95.29 Repararea și întreținerea bunurilor personale și de uz casnic n.c.a.</skos:prefLabel>
	<skos:prefLabel xml:lang="sl">95.29 Popravila in vzdrževanje izdelkov za široko rabo, d. n.</skos:prefLabel>
	<skos:prefLabel xml:lang="sv">95.29 Reparation och underhåll av övriga hushållsartiklar och varor för personligt bruk</skos:prefLabel>
	<skos:prefLabel xml:lang="de">95.29 Reparatur und Instandhaltung von Gebrauchsgütern a. n. g.</skos:prefLabel>
	<skos:prefLabel xml:lang="pl">95.29 Naprawa i konserwacja artykułów użytku osobistego i domowego, gdzie indziej niesklasyfikowana</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">95.29 Oprava a údržba osobných potrieb a potrieb pre domácnosti i. n.</skos:prefLabel>
</rdf:Description>

<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/953">
