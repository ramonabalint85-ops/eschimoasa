<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/853">
	<skos:prefLabel xml:lang="en">85.3 Secondary and post-secondary non-tertiary education</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">85.3 Enseignement secondaire et enseignement post-secondaire non supérieur</skos:prefLabel>
	<skos:prefLabel xml:lang="bg">85.3 Прогимназиално (втори етап на основното образование) и средно образование и професионално обучение след средно образование, но не висше</skos:prefLabel>
