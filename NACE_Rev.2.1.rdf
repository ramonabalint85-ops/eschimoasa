<rdf:Description rdf:about="http://data.europa.eu/ux2/nace2.1/5819">
	<skos:prefLabel xml:lang="en">58.19 Other publishing activities, except software publishing</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">58.19 Autres activités d’édition, à l’exception de l’édition de logiciels</skos:prefLabel>
	<skos:prefLabel xml:lang="bg">58.19 Друга издателска дейност, без издаване на програмни продукти</skos:prefLabel>
	<skos:prefLabel xml:lang="cs">58.19 Ostatní vydavatelské činnosti, kromě vydávání softwaru</skos:prefLabel>
	<skos:prefLabel xml:lang="da">58.19 Andre udgiveraktiviteter, undtagen udgivelse af software</skos:prefLabel>
	<skos:prefLabel xml:lang="el">58.19 Άλλες εκδοτικές δραστηριότητες, εκτός από έκδοση λογισμικού</skos:prefLabel>
	<skos:prefLabel xml:lang="es">58.19 Otras actividades editoriales, excepto la edición de programas informáticos</skos:prefLabel>
	<skos:prefLabel xml:lang="et">58.19 Muu kirjastamine, v.a tarkvara kirjastamine</skos:prefLabel>
	<skos:prefLabel xml:lang="fi">58.19 Muu kustannustoiminta pois lukien ohjelmistojen kustantaminen</skos:prefLabel>
	<skos:prefLabel xml:lang="ga">58.19 Gníomhaíochtaí foilsitheoireachta eile, seachas foilsitheoireacht bogearraí</skos:prefLabel>
	<skos:prefLabel xml:lang="hr">58.19 Ostale izdavačke djelatnosti, osim izdavanja softvera</skos:prefLabel>
	<skos:prefLabel xml:lang="hu">58.19 Egyéb kiadói tevékenység (kivéve: szoftverkiadás)</skos:prefLabel>
	<skos:prefLabel xml:lang="it">58.19 Altre attività editoriali, esclusa l’edizione di software</skos:prefLabel>
	<skos:prefLabel xml:lang="lt">58.19 Kita leidybinė veikla, išskyrus programinės įrangos leidybą</skos:prefLabel>
	<skos:prefLabel xml:lang="lv">58.19 Cita izdevējdarbība, izņemot programmatūras tiražēšanu</skos:prefLabel>
	<skos:prefLabel xml:lang="mt">58.19 Attivitajiet oħra tal-pubblikazzjoni, għajr il-pubblikazzjoni tas-software</skos:prefLabel>
	<skos:prefLabel xml:lang="nl">58.19 Overige activiteiten van uitgeverijen, met uitzondering van het uitgeven van software</skos:prefLabel>
	<skos:prefLabel xml:lang="pt">58.19 Outras atividades de edição, exceto edição de programas informáticos</skos:prefLabel>
	<skos:prefLabel xml:lang="ro">58.19 Alte activități de editare, cu excepția editării de software</skos:prefLabel>
	<skos:prefLabel xml:lang="sl">58.19 Drugo založništvo, razen izdajanja programske opreme</skos:prefLabel>
	<skos:prefLabel xml:lang="sk">58.19 Ostatné vydavateľské činnosti okrem vydávania softvéru</skos:prefLabel>
	<skos:prefLabel xml:lang="sv">58.19 Annan förlagsverksamhet, utom utgivning av programvara</skos:prefLabel>
	<skos:prefLabel xml:lang="de">58.19 Sonstiges Verlagswesen, ohne Software</skos:prefLabel>
	<skos:prefLabel xml:lang="pl">58.19 Pozostała działalność wydawnicza, z wyłączeniem w zakresie oprogramowania</skos:prefLabel>
</rdf:Description>

